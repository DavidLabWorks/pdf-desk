                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Border>

            <!-- The middle viewport owns all horizontal overflow. The side buttons keep their own columns. -->
            <Border x:Name="EditToolbarSurface" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="4,1"
                    Background="{ThemeResource HomeCardBrush}" CornerRadius="{StaticResource ReaderToolbarRadius}"
                    Translation="0,0,12">
                <Border.Shadow><ThemeShadow /></Border.Shadow>
                <ScrollViewer x:Name="EditToolbarScroll" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
