                            Width="{StaticResource HeaderHeight}" Height="{StaticResource HeaderHeight}"
                            Style="{StaticResource IconButtonStyle}" CornerRadius="{StaticResource RadiusMedium}"
                            Background="{ThemeResource HomeSectionBrush}" AutomationProperties.Name="{Binding ShelfSort, Source={StaticResource UiText}}"
                            ToolTipService.ToolTip="{Binding ShelfSort, Source={StaticResource UiText}}">
                        <Button.Flyout>
                            <MenuFlyout Opening="ShelfSortMenu_Opening" Placement="BottomEdgeAlignedRight">
                                <ToggleMenuFlyoutItem x:Name="SortName" Text="{Binding ShelfSortName, Source={StaticResource UiText}}" Click="ShelfSort_Click" />
                                <ToggleMenuFlyoutItem x:Name="SortOpened" Text="{Binding LastOpened, Source={StaticResource UiText}}" Click="ShelfSort_Click" />
                                <MenuFlyoutSeparator />
                                <ToggleMenuFlyoutItem x:Name="SortAscending" Click="ShelfSort_Click" />
                                <ToggleMenuFlyoutItem x:Name="SortDescending" Click="ShelfSort_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <FontIcon Glyph="&#xE8CB;" FontSize="18" />
                    </Button>
                    <Border Grid.Column="3" VerticalAlignment="Center" Background="{ThemeResource HomeSectionBrush}"
                            CornerRadius="{StaticResource RadiusMedium}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ShelfCardMode" GroupName="ShelfViewMode" Style="{StaticResource ShelfViewSegmentStyle}"
                                         CornerRadius="8,0,0,8" Checked="ShelfViewMode_Checked"
                                         AutomationProperties.Name="{Binding CardView, Source={StaticResource UiText}}"
                                         ToolTipService.ToolTip="{Binding CardView, Source={StaticResource UiText}}">
                                <GeometryGroup>
                                    <RectangleGeometry Rect="3,1,5,5" />
                                    <RectangleGeometry Rect="12,1,5,5" />
                                    <RectangleGeometry Rect="3,10,5,5" />
                                    <RectangleGeometry Rect="12,10,5,5" />
                                </GeometryGroup>
                            </RadioButton>
                            <RadioButton x:Name="ShelfListMode" GroupName="ShelfViewMode" Style="{StaticResource ShelfViewSegmentStyle}"
                                         CornerRadius="0,8,8,0" Checked="ShelfViewMode_Checked"
                                         AutomationProperties.Name="{Binding ListView, Source={StaticResource UiText}}"
                                         ToolTipService.ToolTip="{Binding ListView, Source={StaticResource UiText}}">
                                <GeometryGroup>
                                    <LineGeometry StartPoint="3,3" EndPoint="17,3" />
                                    <LineGeometry StartPoint="3,8" EndPoint="17,8" />
                                    <LineGeometry StartPoint="3,13" EndPoint="17,13" />
                                </GeometryGroup>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                    <Button x:Name="ShelfOpenButton" Content="{Binding OpenOrCreatePdf, Source={StaticResource UiText}}"
                            AutomationProperties.Name="{Binding OpenOrCreatePdf, Source={StaticResource UiText}}"
                            ToolTipService.ToolTip="{Binding OpenOrCreatePdfShortcut, Source={StaticResource UiText}}"
                            Grid.Column="4" VerticalAlignment="Stretch" Click="OpenButton_Click" Style="{StaticResource HomeBrowseButtonStyle}" />
                </Grid>

                <Grid Canvas.ZIndex="1" x:Name="FolderBar" Grid.Row="2" Width="200" Margin="8,0,4,24" Padding="8,12,2,8" Background="{ThemeResource HomeShelfBrush}" CornerRadius="10" RowDefinitions="Auto,*,Auto" RowSpacing="6" Visibility="Collapsed">
                    <TextBlock Text="{Binding FavoriteFoldersLabel, Source={StaticResource UiText}}" Margin="10,0,0,0"
                               Padding="0,6" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView x:Name="FolderLocations" Grid.Row="1" ItemContainerStyle="{StaticResource FolderNavigationItemStyle}" SelectionChanged="FolderLocation_Changed"
                              AutomationProperties.Name="{Binding FavoriteFoldersLabel, Source={StaticResource UiText}}" ContainerContentChanging="FolderLocation_Prepared">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border MinHeight="44" Padding="10,0" CornerRadius="7" BorderThickness="1.5"
                                            Background="Transparent" AllowDrop="True"
                                            DragOver="Folder_DragOver" DragLeave="Folder_DragLeave" Drop="Folder_Drop">
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FavoriteLocationTemplate}"
                                                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
                                    </Border>
                                    <Border Height="1" Margin="4,4,4,5" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            Visibility="{Binding DividerVisibility}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="2" Margin="0,0,6,0" RowDefinitions="Auto,Auto" RowSpacing="5">
                        <Border Height="1" Margin="8,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Button Grid.Row="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,7"
                                Style="{ThemeResource SubtleButtonStyle}" Click="NewFavoriteFolder_Click"
                                AutomationProperties.Name="{Binding NewFavoriteFolder, Source={StaticResource UiText}}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8F4;" FontSize="16" />
                                <TextBlock Text="{Binding NewFavoriteFolder, Source={StaticResource UiText}}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
                <controls:ShelfGridView x:Name="RecentThumbs" Grid.Column="0" Grid.ColumnSpan="2" ContainerContentChanging="RecentCard_ContainerContentChanging" Grid.Row="2" Margin="8,0,8,24" Padding="8,16,8,0"
                          Background="{ThemeResource HomeShelfBrush}" CornerRadius="12"
                          SelectionMode="None" ShowsScrollingPlaceholders="False" Visibility="Collapsed">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection>
                        </TransitionCollection>
                    </GridView.ItemContainerTransitions>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="8,0,8,16" />
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridViewItem">
                                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="controls:RecentCard">
                            <Grid ContextRequested="ShelfItem_ContextRequested" Width="{StaticResource ShelfCardWidth}" HorizontalAlignment="Center">
                            <FlyoutBase.AttachedFlyout>
                                <MenuFlyout Opening="RecentMenu_Opening" />
                            </FlyoutBase.AttachedFlyout>
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Padding="0" CornerRadius="10" Background="{ThemeResource HomeCardBrush}"
                                    Foreground="{ThemeResource HomeTextBrush}" BorderBrush="{ThemeResource HomeOutlineBrush}" Tag="ShelfDocument" IsHoldingEnabled="False" ManipulationMode="None" Click="RecentOpen_Click"
                                    AutomationProperties.Name="{x:Bind DisplayName}" ToolTipService.ToolTip="{x:Bind Path}">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource HomeCardHoverTextColor}" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource HomeCardHoverTextColor}" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource HomeCardHoverColor}" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource HomeCardHoverColor}" />
                                </Button.Resources>
                                <StackPanel Spacing="0">
                                    <Grid Height="{StaticResource CardHeight}" Padding="14" CornerRadius="9,9,0,0"
                                          AutomationProperties.AccessibilityView="Raw">
                                        <Border
                                        Width="{StaticResource HomePlaceholderCoverWidth}"
                                        Height="{StaticResource HomePlaceholderCoverHeight}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource HomeCoverStyle}"
                                        Background="{ThemeResource HomeLayerBrush}"
                                        Visibility="{x:Bind ShowPlaceholder, Mode=OneWay}">
                                            <FontIcon
                                            Glyph="&#xEA90;"
                                            FontSize="{StaticResource HomePreviewIconSize}"
                                            Foreground="{ThemeResource HomeSecondaryTextBrush}" />
                                        </Border>
                                        <Border
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource HomeCoverStyle}"
                                        Visibility="{x:Bind HasThumbnail, Mode=OneWay}">
                                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Margin="10,0,10,0" FontSize="14" LineHeight="18"
                                               FontWeight="Normal" TextWrapping="Wrap" MaxLines="2"
                                               SizeChanged="RecentName_SizeChanged" DataContextChanged="RecentName_DataContextChanged" />
                                    <TextBlock Text="{x:Bind Metadata, Mode=OneWay}" Margin="10,3,10,10"
                                               FontSize="12" Opacity="0.72" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind LastOpened}" />
                                </StackPanel>
                            </Button>
                            <controls:ShelfSelectionCheckBox Width="32" MinWidth="0" Height="32" Padding="5,0,0,0" HorizontalAlignment="Left"
                                      VerticalAlignment="Top" Margin="4" Click="RecentSelection_Click"
                                      IsChecked="{x:Bind IsSelected, Mode=OneWay}" IsRevealed="{x:Bind CanSelect, Mode=OneWay}"
                                      AutomationProperties.Name="{x:Bind DisplayName}" />
                            <ToggleButton Style="{StaticResource ShelfFavoriteToggleStyle}" Margin="4"
                                          HorizontalAlignment="Right" VerticalAlignment="Top"
                                          IsChecked="{x:Bind IsFavorite, Mode=OneWay}" Click="FavoriteStar_Click"
                                          AutomationProperties.Name="{x:Bind FavoriteAction, Mode=OneWay}"
                                          ToolTipService.ToolTip="{x:Bind FavoriteAction, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </controls:ShelfGridView>
                <controls:ShelfGridView Canvas.ZIndex="1" x:Name="FavoriteThumbs" Grid.Column="1" Grid.Row="2" Visibility="Collapsed"
                          Margin="{Binding Margin, ElementName=RecentThumbs}" Padding="{Binding Padding, ElementName=RecentThumbs}"
                          Background="{ThemeResource HomeShelfBrush}" CornerRadius="12"
                          SelectionMode="None" ShowsScrollingPlaceholders="False"
                          ContainerContentChanging="RecentCard_ContainerContentChanging"
                          ItemsPanel="{Binding ItemsPanel, ElementName=RecentThumbs}"
                          ItemContainerStyle="{Binding ItemContainerStyle, ElementName=RecentThumbs}"
                          ItemTemplate="{Binding ItemTemplate, ElementName=RecentThumbs}">
                    <GridView.ItemContainerTransitions><TransitionCollection /></GridView.ItemContainerTransitions>
                </controls:ShelfGridView>
                <Grid x:Name="ShelfListSurface" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Visibility="Collapsed"
                      Margin="{Binding Margin, ElementName=RecentThumbs}" Background="{ThemeResource HomeShelfBrush}"
                      CornerRadius="12" Padding="16">
                <ListView x:Name="ShelfList" VerticalAlignment="Top"
                          Background="{ThemeResource HomeCardBrush}" CornerRadius="12"
                          SelectionMode="None" ShowsScrollingPlaceholders="False"
                          ContainerContentChanging="RecentCard_ContainerContentChanging">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="controls:RecentCard">
                            <Grid ContextRequested="ShelfItem_ContextRequested" ColumnSpacing="{StaticResource SpaceM}"
                                  MinHeight="84" Padding="16,0,12,0"
                                  BorderBrush="{ThemeResource HomeOutlineBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="4*" />
                                    <ColumnDefinition Width="*" MaxWidth="138" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FlyoutBase.AttachedFlyout>
                                    <MenuFlyout Opening="RecentMenu_Opening" />
                                </FlyoutBase.AttachedFlyout>
                                <Button Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        BorderThickness="0" Background="Transparent"
                                        CornerRadius="{StaticResource RadiusMedium}"
                                        Tag="ShelfDocument" IsHoldingEnabled="False" ManipulationMode="None" Click="RecentOpen_Click" AutomationProperties.Name="{x:Bind DisplayName}"
                                        ToolTipService.ToolTip="{x:Bind Path}" />
                                <controls:ShelfSelectionCheckBox Width="32" MinWidth="0" Height="32" Padding="5,0,0,0" HorizontalAlignment="Left"
                                      VerticalAlignment="Center" Margin="0" Click="RecentSelection_Click"
                                      IsChecked="{x:Bind IsSelected, Mode=OneWay}" IsRevealed="{x:Bind CanSelect, Mode=OneWay}"
                                      AutomationProperties.Name="{x:Bind DisplayName}" />
                                <Grid Grid.Column="1" Width="48" Height="60" VerticalAlignment="Center"
                                      IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                                    <Border Width="40" Height="52" Style="{StaticResource HomeCoverStyle}"
                                            Visibility="{x:Bind ShowPlaceholder, Mode=OneWay}">
                                        <FontIcon Glyph="&#xEA90;" FontSize="18" Foreground="{ThemeResource HomeSecondaryTextBrush}" />
                                    </Border>
                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform"
                                           Visibility="{x:Bind HasThumbnail, Mode=OneWay}" />
                                </Grid>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4" IsHitTestVisible="False">
                                    <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis"
                                               FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource HomeTextBrush}"
                                               AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource HomeSecondaryTextBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="4" IsHitTestVisible="False">
                                    <TextBlock Text="{x:Bind LastOpened}" TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource HomeSecondaryTextBrush}"
                                               AutomationProperties.Name="{Binding LastOpened, Source={StaticResource UiText}}" />
                                    <TextBlock Text="{x:Bind FileSize, Mode=OneWay}" TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource HomeSecondaryTextBrush}" />
                                </StackPanel>
                                <ToggleButton Grid.Column="4" Style="{StaticResource ShelfFavoriteToggleStyle}" VerticalAlignment="Center"
                                              IsChecked="{x:Bind IsFavorite, Mode=OneWay}" Click="FavoriteStar_Click"
                                              AutomationProperties.Name="{x:Bind FavoriteAction, Mode=OneWay}"
                                              ToolTipService.ToolTip="{x:Bind FavoriteAction, Mode=OneWay}" />
                                <Button Grid.Column="5" VerticalAlignment="Center" Style="{StaticResource IconButtonStyle}"
                                        Background="{ThemeResource HomeLayerBrush}" CornerRadius="{StaticResource RadiusMedium}"
                                        Click="RecentMore_Click"
                                        AutomationProperties.Name="{Binding MoreFileActions, Source={StaticResource UiText}}"
                                        ToolTipService.ToolTip="{Binding MoreFileActions, Source={StaticResource UiText}}">
                                    <SymbolIcon Symbol="More" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                </Grid>
                <Grid Canvas.ZIndex="1" x:Name="FavoriteListSurface" Grid.Column="1" Grid.Row="2" Visibility="Collapsed"
                      Margin="{Binding Margin, ElementName=RecentThumbs}" Background="{ThemeResource HomeShelfBrush}"
                      CornerRadius="12" Padding="16">
                    <ListView x:Name="FavoriteList" VerticalAlignment="Top" SelectionMode="None"
                              Background="{ThemeResource HomeCardBrush}" CornerRadius="12" ShowsScrollingPlaceholders="False"
                              ItemContainerStyle="{Binding ItemContainerStyle, ElementName=ShelfList}"
                              ItemTemplate="{Binding ItemTemplate, ElementName=ShelfList}"
                              ContainerContentChanging="RecentCard_ContainerContentChanging" />
                </Grid>
                <Border x:Name="ShelfDragBackdrop" Grid.Row="2" Grid.ColumnSpan="2" IsHitTestVisible="False"
                        Background="{ThemeResource HomeCanvasBrush}" Visibility="Collapsed" />
                <Grid Canvas.ZIndex="1" x:Name="NoFavorites" Grid.Column="1" Grid.Row="2" Visibility="Collapsed" Margin="24,0,24,24"
                      ColumnDefinitions="Auto,Auto" ColumnSpacing="20"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="56" Height="68" VerticalAlignment="Center"
                          AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False">
                        <Border Width="44" Height="56" CornerRadius="5" Margin="0,0,8,6"
                                Background="{ThemeResource HomeLayerBrush}" BorderThickness="1"
                                BorderBrush="{ThemeResource HomePaperStrokeBrush}" RenderTransformOrigin="0.5,0.8">
                            <Border.RenderTransform><RotateTransform Angle="-10" /></Border.RenderTransform>
                        </Border>
                        <Border Width="44" Height="56" CornerRadius="5" Margin="8,4,0,0"
                                Background="{ThemeResource HomePaperBrush}" BorderThickness="1"
                                BorderBrush="{ThemeResource HomePaperStrokeBrush}">
                            <FontIcon Glyph="&#xE735;" FontSize="21" Foreground="{ThemeResource ShelfFavoriteBrush}" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5" MaxWidth="260">
                        <TextBlock x:Name="FavoriteEmptyTitle" Text="{Binding NoFavoritesYet, Source={StaticResource UiText}}" FontSize="20" FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="Level2" Foreground="{ThemeResource HomeTextBrush}" />
                        <TextBlock x:Name="FavoritesHint" TextWrapping="Wrap" FontSize="14" LineHeight="20"
                                   Foreground="{ThemeResource HomeSecondaryTextBrush}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer
                    x:Name="EmptyState" Grid.Column="1"
                    Grid.Row="2"
                    HorizontalScrollMode="Disabled"
                    SizeChanged="EmptyState_SizeChanged">
                    <Grid MinHeight="{x:Bind EmptyState.ViewportHeight, Mode=OneWay}" Padding="0,8">
                        <StackPanel
                            x:Name="HomeOpener"
                            Orientation="Horizontal"
                            Spacing="{StaticResource SpaceXL}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Viewbox
                                x:Name="HomePaperArt"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw">
                                <Grid
                                    Width="{StaticResource HomePaperStackWidth}"
                                    Height="{StaticResource HomePaperStackHeight}">
                                    <Border
                                        Width="{StaticResource HomePaperWidth}"
                                        Height="{StaticResource HomePaperHeight}"
                                        Margin="18,6,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        CornerRadius="{StaticResource RadiusMedium}"
                                        Background="{ThemeResource HomeLayerBrush}"
                                        BorderBrush="{ThemeResource HomePaperStrokeBrush}"
                                        BorderThickness="1"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="10" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border
                                        Width="{StaticResource HomePaperWidth}"
                                        Height="{StaticResource HomePaperHeight}"
                                        Margin="8,12,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Padding="10"
                                        CornerRadius="{StaticResource RadiusMedium}"
                                        Background="{ThemeResource HomePaperBrush}"
                                        BorderBrush="{ThemeResource HomePaperStrokeBrush}"
                                        BorderThickness="1"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="-7" />
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Border
                                                Padding="4,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Background="{ThemeResource HomeLayerBrush}"
                                                CornerRadius="{StaticResource RadiusSmall}">
                                                <TextBlock
                                                    Text="PDF"
                                                    FontSize="{StaticResource HomePaperLabelSize}"
                                                    FontWeight="Bold"
                                                    Foreground="{ThemeResource HomeTextBrush}" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Bottom" Spacing="{StaticResource SpaceXS}">
                                                <Rectangle Width="36" Height="1" HorizontalAlignment="Left" Fill="{ThemeResource HomePaperStrokeBrush}" />
                                                <Rectangle Width="28" Height="1" HorizontalAlignment="Left" Fill="{ThemeResource HomePaperStrokeBrush}" />
                                                <Rectangle Width="20" Height="1" HorizontalAlignment="Left" Fill="{ThemeResource HomePaperStrokeBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center" Spacing="{StaticResource SpaceXS}">
                                <TextBlock
                                    x:Name="HomeOpenHeading"
                                    Text="{Binding NoRecentFiles, Source={StaticResource UiText}}"
                                    AutomationProperties.HeadingLevel="Level1"
                                    Style="{StaticResource HomeHeadingStyle}"
                                    FontSize="{StaticResource HomeOpenerHeadingSize}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="HomeOpenHint"
                                    Text="{Binding DragAFileHereToOpenIt, Source={StaticResource UiText}}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource HomeSecondaryTextBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <Canvas Canvas.ZIndex="2" x:Name="ShelfDragLayer" Grid.RowSpan="3" Grid.ColumnSpan="2"
                        IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                    <Border x:Name="ShelfDragPreview" Visibility="Collapsed" Width="196" Height="52"
                            Padding="10,6" CornerRadius="8" Background="{ThemeResource HomePaperBrush}"
                            BorderBrush="{ThemeResource HomePaperStrokeBrush}" BorderThickness="1">
                        <Border.RenderTransform><TranslateTransform x:Name="ShelfDragOffset" /></Border.RenderTransform>
                        <Grid ColumnDefinitions="30,*" ColumnSpacing="10">
                            <FontIcon x:Name="ShelfDragFileIcon" Glyph="&#xEA90;" FontSize="22" />
                            <Image x:Name="ShelfDragCover" Stretch="Uniform" />
                            <Border x:Name="ShelfDragBlocked" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Visibility="Collapsed" Background="{ThemeResource HomePaperBrush}" Padding="2" CornerRadius="9">
                                <FontIcon Glyph="&#xE733;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </Border>
                            <TextBlock Grid.Column="1" x:Name="ShelfDragName" VerticalAlignment="Center"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </Canvas>
            </Grid>

            <!-- Window-level notices: messages that arrive with no document to
                 attach them to (startup problems, a missing recent file, a
                 background failure). Anything about an open document goes to
                 that DocumentView's own NoticeHost instead, which is bounded to
                 the page area so it can't cover the sidebar.

                 Declared before the zoom pill and find bar so active UI always
                 paints over a passive notice, never the other way round. -->
            <controls:NoticeHost x:Name="WindowNotice" />

            <!-- The format bar for the text box being typed into. It floats at
                 the top of the page area, out of the way of a caret that is
                 usually further down, and only exists while a box is open.
                 Its controls are built in code so the font and size lists come
                 from one place (TextBoxFonts) rather than being duplicated in
                 markup that could drift from it. -->
            <Grid x:Name="ReaderOverlays">
            <Border
                x:Name="TextFormatBar"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="8,12,8,0"
                MinHeight="{StaticResource TouchTargetMin}"
                Padding="6,4"
                Background="{ThemeResource HomeCardBrush}"
                CornerRadius="{StaticResource ReaderToolbarRadius}"
                Translation="0,0,24">
                <Border.Shadow><ThemeShadow /></Border.Shadow>
                <Border.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.MergedDictionaries>
                            <ResourceDictionary Source="ms-appx:///Styles/ReaderToolbarFeedback.xaml" />
                        </ResourceDictionary.MergedDictionaries>
                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource ReaderToggleCheckedColor}" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource ReaderToggleCheckedHoverColor}" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource ReaderToggleCheckedHoverColor}" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource ReaderToggleTextColor}" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource ReaderToggleTextColor}" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource ReaderToggleTextColor}" />
                    </ResourceDictionary>
                </Border.Resources>
                <ScrollViewer x:Name="TextFormatScroll" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TextFormatControls" Orientation="Horizontal" Spacing="2"
                                VerticalAlignment="Center" PointerWheelChanged="TextFormat_PointerWheelChanged" />
                </ScrollViewer>
            </Border>

            <controls:DocumentFindBar x:Name="FindBar" Visibility="Collapsed"
                                      VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,16,0" />

            </Grid>

            <Border x:Name="ReaderQuickTools" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Width="{StaticResource ExpandedReaderPanelWidth}"
                    Margin="8,4,16,16" Padding="3,0" Translation="0,0,24"
                    Background="{ThemeResource HomeCardBrush}" CornerRadius="{StaticResource ReaderToolbarRadius}">
                <Border.Resources>
                    <ResourceDictionary Source="ms-appx:///Styles/ReaderToolbarFeedback.xaml" />
                </Border.Resources>
                <Border.Shadow><ThemeShadow /></Border.Shadow>
                <Grid>
                    <Button x:Name="DockedReaderToggle" Visibility="Collapsed" Click="QuickToolsToggle_Click"
                            HorizontalAlignment="Stretch" Height="{StaticResource TouchTargetMin}" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="{Binding ExpandQuickTools, Source={StaticResource UiText}}"
                            ToolTipService.ToolTip="{Binding ExpandQuickTools, Source={StaticResource UiText}}">
                        <FontIcon Glyph="&#xE76B;" FontSize="12" />
                    </Button>
                <ScrollViewer x:Name="ExpandedQuickTools" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" ZoomMode="Disabled">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                MinHeight="{StaticResource TouchTargetMin}">
                        <Button x:Name="QuickToolsToggle" Style="{StaticResource ZoomControlButtonStyle}" Click="QuickToolsToggle_Click">
                            <FontIcon x:Name="QuickToolsToggleGlyph" FontSize="12" />
                        </Button>
                        <Grid x:Name="QuickPageEntry" Height="28" ColumnDefinitions="Auto,Auto" VerticalAlignment="Center">
                            <NumberBox x:Name="PageBox" Width="44" Padding="4,0"
                                       Minimum="1" SpinButtonPlacementMode="Hidden"
                                       IsEnabled="False" ValueChanged="PageBox_ValueChanged"
                                       FontSize="12" FontWeight="Normal" Background="{ThemeResource FieldSurfaceBrush}"
                                       BorderThickness="1" BorderBrush="{ThemeResource FieldOutlineBrush}"
                                       CornerRadius="{StaticResource FieldRadius}"
                                       AutomationProperties.Name="{Binding PageNumber, Source={StaticResource UiText}}"
                                       ToolTipService.ToolTip="{Binding GoToPageShortcut, Source={StaticResource UiText}}">
                                <NumberBox.Template>
                                    <ControlTemplate TargetType="NumberBox">
                                        <TextBox x:Name="InputBox" MinWidth="0" MinHeight="0" TextAlignment="Center"
                                                 InputScope="{TemplateBinding InputScope}" FontFamily="{TemplateBinding FontFamily}"
                                                 FontSize="{TemplateBinding FontSize}"
                                                 FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}"
                                                 Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                 BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                                                 Padding="{TemplateBinding Padding}">
                                            <TextBox.Template>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Grid Background="Transparent">
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="CommonStates">
                                                                <VisualState x:Name="Normal" />
                                                                <VisualState x:Name="Focused">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="FieldBorder.BorderBrush" Value="{ThemeResource TextControlBorderBrushFocused}" />
                                                                        <Setter Target="FieldBorder.Background" Value="{ThemeResource TextControlBackgroundFocused}" />
                                                                        <Setter Target="FieldBorder.BorderThickness" Value="{StaticResource TextControlBorderThemeThicknessFocused}" />
                                                                        <Setter Target="PageNumberDisplay.Visibility" Value="Collapsed" />
                                                                        <Setter Target="ContentElement.Opacity" Value="1" />
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Disabled">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="PageNumberDisplay.Opacity" Value="0.5" />
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>
                                                        <Border x:Name="FieldBorder" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="{TemplateBinding CornerRadius}" />
                                                        <ScrollViewer x:Name="ContentElement" VerticalAlignment="Center"
                                                                      Margin="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                                                      Opacity="0"
                                                                      IsTabStop="False" AutomationProperties.AccessibilityView="Raw"
                                                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                                                      ZoomMode="Disabled" />
                                                        <TextBlock x:Name="PageNumberDisplay" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}"
                                                                   FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                                                   FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}"
                                                                   IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </TextBox.Template>
                                        </TextBox>
                                    </ControlTemplate>
                                </NumberBox.Template>
                            </NumberBox>
                            <TextBlock x:Name="PageCountLabel" Grid.Column="1" Margin="3,0,1,0" VerticalAlignment="Center"
                                       FontFamily="{Binding FontFamily, ElementName=PageBox}"
                                       FontSize="{Binding FontSize, ElementName=PageBox}"
                                       FontWeight="{Binding FontWeight, ElementName=PageBox}"
                                       Foreground="{ThemeResource HomeSecondaryTextBrush}" />
                        </Grid>
                        <Button x:Name="PreviousPageButton" Style="{StaticResource ZoomControlButtonStyle}" IsEnabled="False"
                                Click="PreviousPageButton_Click" AutomationProperties.Name="{Binding PreviousPage, Source={StaticResource UiText}}"
                                ToolTipService.ToolTip="{Binding PreviousPage, Source={StaticResource UiText}}">
                            <FontIcon Glyph="&#xE70E;" FontSize="14" />
                        </Button>
                        <Button x:Name="NextPageButton" Style="{StaticResource ZoomControlButtonStyle}" IsEnabled="False"
                                Click="NextPageButton_Click" AutomationProperties.Name="{Binding NextPage, Source={StaticResource UiText}}"
                                ToolTipService.ToolTip="{Binding NextPage, Source={StaticResource UiText}}">
                            <FontIcon Glyph="&#xE70D;" FontSize="14" />
                        </Button>
                        <Border Style="{StaticResource HeaderSeparatorStyle}" Margin="5,0" />
                        <Button
                            x:Name="ZoomOutButton"
                            Style="{StaticResource ZoomControlButtonStyle}"
                            Click="ZoomOutButton_Click"
                            IsEnabled="False"
                            AutomationProperties.Name="{Binding ZoomOut, Source={StaticResource UiText}}" ToolTipService.ToolTip="{Binding ZoomOutCtrl, Source={StaticResource UiText}}">
                            <FontIcon Glyph="&#xE738;" FontSize="14" />
                        </Button>
                        <Button
                            x:Name="ZoomLabelButton"
                            Background="{ThemeResource HomeLayerBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                            Height="28"
                            MinWidth="50"
                            Padding="4,0"
                            CornerRadius="{StaticResource RadiusMedium}"
                            IsEnabled="False"
                            AutomationProperties.Name="{Binding ZoomLevel, Source={StaticResource UiText}}" ToolTipService.ToolTip="{Binding ZoomLevel, Source={StaticResource UiText}}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock x:Name="ZoomLabel" Text="100%" FontWeight="SemiBold"
                                           Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{ThemeResource HomeSecondaryTextBrush}" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout Placement="TopEdgeAlignedRight">
                                    <MenuFlyoutItem Text="50%" Click="ZoomPreset_Click" Tag="0.5" />
                                    <MenuFlyoutItem Text="100%" Click="ZoomPreset_Click" Tag="1.0" KeyboardAcceleratorTextOverride="Ctrl+1" />
                                    <MenuFlyoutItem Text="150%" Click="ZoomPreset_Click" Tag="1.5" />
                                    <MenuFlyoutItem Text="200%" Click="ZoomPreset_Click" Tag="2.0" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button
                            x:Name="ZoomInButton"
                            Style="{StaticResource ZoomControlButtonStyle}"
                            Click="ZoomInButton_Click"
                            IsEnabled="False"
                            AutomationProperties.Name="{Binding ZoomIn, Source={StaticResource UiText}}" ToolTipService.ToolTip="{Binding ZoomInCtrl, Source={StaticResource UiText}}">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                        </Button>
                        <Button x:Name="PresentButton" Style="{StaticResource ZoomControlButtonStyle}" IsEnabled="False"
                                Click="PresentButton_Click" AutomationProperties.Name="{Binding Presentation, Source={StaticResource UiText}}"
                                ToolTipService.ToolTip="{Binding PresentationShortcut, Source={StaticResource UiText}}">
                            <FontIcon Glyph="&#xE7F4;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>

            <Border x:Name="ImportStatus" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,12,0,0" Background="{ThemeResource HomeCardBrush}" BorderBrush="{ThemeResource HomeOutlineBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,8" AutomationProperties.LiveSetting="Polite">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ProgressRing IsActive="True" Width="16" Height="16" />
                    <TextBlock Text="{Binding CopyingToLibrary, Source={StaticResource UiText}}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <controls:CommandPalette x:Name="Palette" />
        </Grid>

        <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Grid.RowSpan="2" Margin="4" CornerRadius="6"
                      Background="{ThemeResource HomeCanvasBrush}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <Grid Padding="28,24,28,32">
                <StackPanel MaxWidth="704" HorizontalAlignment="Stretch" Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="SettingsBack" Style="{StaticResource SubtleButtonStyle}" Click="SettingsBack_Click" AutomationProperties.Name="{Binding Back, Source={StaticResource UiText}}">
                            <FontIcon Glyph="&#xE72B;" FontSize="16" />
                        </Button>
                        <TextBlock Text="{Binding Settings, Source={StaticResource UiText}}" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding Appearance, Source={StaticResource UiText}}" FontSize="14" FontWeight="SemiBold" />
                        <Border Background="{ThemeResource HomeCardBrush}" BorderBrush="{ThemeResource HomeOutlineBrush}" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="16,8" MinHeight="52">
                                    <TextBlock Text="{Binding Theme, Source={StaticResource UiText}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ComboBox x:Name="ThemeChoice" Grid.Column="1" Width="158" AutomationProperties.Name="{Binding Theme, Source={StaticResource UiText}}" SelectionChanged="PreferenceChanged">
                                        <ComboBoxItem Content="{Binding FollowSystem, Source={StaticResource UiText}}" />
                                        <ComboBoxItem Content="{Binding Light, Source={StaticResource UiText}}" />
                                        <ComboBoxItem Content="{Binding Dark, Source={StaticResource UiText}}" />
                                    </ComboBox>
                                </Grid>
                                <Border Height="1" Margin="16,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="16,8" MinHeight="52">
                                    <TextBlock Text="{Binding Language, Source={StaticResource UiText}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ComboBox x:Name="LanguageChoice" Grid.Column="1" Width="158" AutomationProperties.Name="{Binding Language, Source={StaticResource UiText}}" SelectionChanged="PreferenceChanged">
                                        <ComboBoxItem Content="{Binding FollowSystem, Source={StaticResource UiText}}" />
                                        <ComboBoxItem Content="English" />
                                        <ComboBoxItem Content="简体中文" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding LibraryStorage, Source={StaticResource UiText}}" FontSize="14" FontWeight="SemiBold" />
                        <Border Background="{ThemeResource HomeCardBrush}" BorderBrush="{ThemeResource HomeOutlineBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{Binding LibraryFolderLabel, Source={StaticResource UiText}}" />
                                        <TextBlock x:Name="LibraryPath" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                    <Button x:Name="ChangeLibraryFolder" Grid.Column="1" VerticalAlignment="Center" Click="ChangeLibraryFolder_Click"
                                            Content="{Binding ChangeFolder, Source={StaticResource UiText}}" />
                                </Grid>
                                <TextBlock Text="{Binding LibraryFolderHint, Source={StaticResource UiText}}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <HyperlinkButton x:Name="ResetLibraryFolder" Padding="0,4" Visibility="Collapsed" Click="ResetLibraryFolder_Click"
                                                 Content="{Binding ResetFolder, Source={StaticResource UiText}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding DefaultPdfAppLabel, Source={StaticResource UiText}}" FontSize="14" FontWeight="SemiBold" />
                        <Border Background="{ThemeResource HomeCardBrush}" BorderBrush="{ThemeResource HomeOutlineBrush}" BorderThickness="1" CornerRadius="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="16,12" MinHeight="52">
                                <TextBlock x:Name="DefaultPdfHint" Text="{Binding DefaultPdfAppHint, Source={StaticResource UiText}}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Grid x:Name="DefaultPdfStatus" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10" Visibility="Collapsed" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                              AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Grid.Column="1" Text="{Binding DefaultPdfAppStatus, Source={StaticResource UiText}}"
                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                                <Button x:Name="SetDefaultPdfButton" Grid.Column="1" VerticalAlignment="Center" Content="{Binding SetDefaultPdfApp, Source={StaticResource UiText}}"
                                        Click="SetDefaultPdfApp_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding Startup, Source={StaticResource UiText}}" FontSize="14" FontWeight="SemiBold" />
                        <Border Background="{ThemeResource HomeCardBrush}" BorderBrush="{ThemeResource HomeOutlineBrush}" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="16,8" MinHeight="52">
                                    <TextBlock Text="{Binding ReopenTabsAtStartup, Source={StaticResource UiText}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ToggleSwitch x:Name="RestoreChoice" Grid.Column="1" MinWidth="0" OffContent="" OnContent="" AutomationProperties.Name="{Binding ReopenTabsAtStartup, Source={StaticResource UiText}}" Toggled="RestoreSession_Toggled" />
                                </Grid>
                                <Border Height="1" Margin="16,0" Background="{ThemeResource HomeOutlineBrush}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="16,8" MinHeight="52">
                                    <TextBlock Text="{Binding CloseBehavior, Source={StaticResource UiText}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ComboBox x:Name="CloseBehaviorChoice" Grid.Column="1" MinWidth="152" VerticalAlignment="Center"
                                              AutomationProperties.Name="{Binding CloseBehavior, Source={StaticResource UiText}}" SelectionChanged="CloseBehavior_SelectionChanged">
                                        <ComboBoxItem Content="{Binding CloseToTray, Source={StaticResource UiText}}" />
                                        <ComboBoxItem Content="{Binding ExitPdfDesk, Source={StaticResource UiText}}" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding About, Source={StaticResource UiText}}" FontSize="14" FontWeight="SemiBold" />
                        <Border Background="{ThemeResource HomeCardBrush}" BorderBrush="{ThemeResource HomeOutlineBrush}" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto" Padding="16,8" MinHeight="52">
                                    <TextBlock Text="{Binding AppVersionLabel, Source={StaticResource UiText}}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="AboutVersion" Grid.Column="1" VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                                </Grid>
                                <Border Height="1" Margin="16,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Padding="16,8" MinHeight="52">
                                    <TextBlock Text="GitHub" VerticalAlignment="Center" />
                                    <HyperlinkButton Grid.Column="1" HorizontalAlignment="Right" Padding="0,4"
                                                     NavigateUri="https://github.com/DavidLabWorks/pdf-desk-windows">
                                        <TextBlock Text="github.com/DavidLabWorks/pdf-desk-windows" TextWrapping="Wrap" />
                                    </HyperlinkButton>
                                </Grid>
                                <Border Height="1" Margin="16,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Padding="16,8" MinHeight="52">
                                    <TextBlock Text="{Binding Feedback, Source={StaticResource UiText}}" VerticalAlignment="Center" />
                                    <HyperlinkButton Grid.Column="1" HorizontalAlignment="Right" Padding="0,4"
                                                     Content="{Binding OpenIssueTracker, Source={StaticResource UiText}}"
                                                     NavigateUri="https://github.com/DavidLabWorks/pdf-desk-windows/issues/new" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border x:Name="ExportQueue" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="16,0,20,64" Visibility="Collapsed" Padding="5" CornerRadius="10" BorderThickness="1"
                Background="{ThemeResource HomeCardBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                Translation="0,0,16">
            <Border.Shadow><ThemeShadow /></Border.Shadow>
            <StackPanel>
                <Button x:Name="QueueToggle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent"
                        BorderThickness="0" Click="ToggleExportQueue_Click" Padding="8,5">
                    <Grid x:Name="QueueHeading" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                        <TextBlock x:Name="QueueLabel" Grid.Column="1" FontWeight="SemiBold" />
                        <FontIcon x:Name="QueueChevron" Grid.Column="2" FontSize="10" />
                    </Grid>
                </Button>
                <ScrollViewer x:Name="ExportTasksScroll" Width="306" MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ExportTasks" />
                </ScrollViewer>
            </StackPanel>
        </Border>

    </Grid>
</Window>
