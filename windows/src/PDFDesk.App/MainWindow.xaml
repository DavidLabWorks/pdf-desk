                    <Grid ColumnDefinitions="Auto,Auto,Auto" PointerWheelChanged="EditTools_PointerWheelChanged">
                    <StackPanel x:Name="ViewOnlyStatus" Visibility="Collapsed" Orientation="Horizontal" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXS}" Margin="8,0"
                                    VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource HomeSecondaryTextBrush}"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="ViewOnlyLabel" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource HomeSecondaryTextBrush}"
                                       Text="{Binding ViewOnly, Source={StaticResource UiText}}" />
                        </StackPanel>
                        <Border Style="{StaticResource HeaderSeparatorStyle}" />
                        <Button x:Name="FocusEditor" Style="{StaticResource ReaderSideToolButtonStyle}" Click="FocusEditor_Click" />
                        <Button x:Name="CopySnapshot" Style="{StaticResource ReaderSideToolButtonStyle}" Click="CopySnapshot_Click"
                                Content="{Binding EditCopy, Source={StaticResource UiText}}" />
                    </StackPanel>
                    <StackPanel x:Name="EditTools" Orientation="Horizontal" Spacing="2">
                        <Button x:Name="UndoButton" Style="{StaticResource IconButtonStyle}"
                                AutomationProperties.Name="{Binding Undo, Source={StaticResource UiText}}"
                                ToolTipService.ToolTip="{Binding Undo, Source={StaticResource UiText}}"
                                Click="UndoButton_Click" IsEnabled="False">
                            <FontIcon Glyph="&#xE7A7;" FontSize="{StaticResource IconGlyphSize}" />
                        </Button>
                        <Button x:Name="RedoButton" Style="{StaticResource IconButtonStyle}"
                                AutomationProperties.Name="{Binding Redo, Source={StaticResource UiText}}"
                                ToolTipService.ToolTip="{Binding Redo, Source={StaticResource UiText}}"
                                Click="RedoButton_Click" IsEnabled="False">
                            <FontIcon Glyph="&#xE7A6;" FontSize="{StaticResource IconGlyphSize}" />
                        </Button>
                        <Border Style="{StaticResource HeaderSeparatorStyle}" />
                        <ToggleButton
                            x:Name="PenToolButton"
                            Style="{StaticResource IconToggleButtonStyle}"
                            Click="PenToolButton_Click"
                            PointerEntered="DrawingTool_PointerEntered"
                            PointerMoved="DrawingTool_PointerEntered"
                            PointerExited="DrawingTool_PointerExited"
                            IsEnabled="False"
                            AutomationProperties.Name="{Binding Pen, Source={StaticResource UiText}}" ToolTipService.ToolTip="{Binding PenDrawFreehandCtrlE, Source={StaticResource UiText}}">
                            <FontIcon Glyph="&#xEDFB;" FontSize="{StaticResource IconGlyphSize}" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="HighlighterToolButton"
                            Style="{StaticResource IconToggleButtonStyle}"
                            Click="HighlighterToolButton_Click"
                            PointerEntered="DrawingTool_PointerEntered"
                            PointerMoved="DrawingTool_PointerEntered"
                            PointerExited="DrawingTool_PointerExited"
                            IsEnabled="False"
                            AutomationProperties.Name="{Binding Highlighter, Source={StaticResource UiText}}" ToolTipService.ToolTip="{Binding HighlighterDragOverTextCtrlH, Source={StaticResource UiText}}">
                            <!-- Chisel-tip marker, with the stroke it leaves on the page. -->
                            <PathIcon Width="{StaticResource IconGlyphSize}" Height="{StaticResource IconGlyphSize}"
                                      Data="F0 M6,11 L15.4,1.6 Q16.8,0.2 18.2,1.6 L21.4,4.8 Q22.8,6.2 21.4,7.6 L12,17 L9.3,17.3 L6.8,19.8 L2.5,19.8 L3.7,15.8 L6,13.5 Z
                                            M8,11.2 L11.8,15 L20.2,6.6 Q20.7,6.1 20.2,5.6 L17.4,2.8 Q16.9,2.3 16.4,2.8 Z
                                            M2,21.5 L15,21.5 L15,23.5 L2,23.5 Z" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="NoteToolButton"
                            Style="{StaticResource IconToggleButtonStyle}"
                            Click="NoteToolButton_Click"
                            IsEnabled="False"
                            AutomationProperties.Name="{Binding StickyNote, Source={StaticResource UiText}}" ToolTipService.ToolTip="{Binding NoteClickToAddAStickyNote, Source={StaticResource UiText}}">
                            <ContentPresenter Content="Note" ContentTemplate="{StaticResource StickyNoteGlyph}" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="TextToolButton"
                            Style="{StaticResource IconToggleButtonStyle}"
                            Click="TextToolButton_Click"
                            IsEnabled="False"
                            AutomationProperties.Name="{Binding Text, Source={StaticResource UiText}}" ToolTipService.ToolTip="{Binding TextClickAnywhereOnThePageAndTypeCtrlT, Source={StaticResource UiText}}">
                            <FontIcon Glyph="&#xE8D2;" FontSize="{StaticResource IconGlyphSize}" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="EraserToolButton"
                            Style="{StaticResource IconToggleButtonStyle}"
                            Click="EraserToolButton_Click"
                            PointerEntered="DrawingTool_PointerEntered"
                            PointerMoved="DrawingTool_PointerEntered"
                            PointerExited="DrawingTool_PointerExited"
                            IsEnabled="False"
                            AutomationProperties.Name="{Binding Eraser, Source={StaticResource UiText}}" ToolTipService.ToolTip="{Binding EraserHint, Source={StaticResource UiText}}">
                            <FontIcon Glyph="&#xE75C;" FontSize="{StaticResource IconGlyphSize}" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="ImageToolButton"
                            Style="{StaticResource IconToggleButtonStyle}"
                            Click="ImageToolButton_Click"
                            IsEnabled="False"
                            AutomationProperties.Name="{Binding Picture, Source={StaticResource UiText}}"
                            ToolTipService.ToolTip="{Binding PicturePlaceAnImageOnThePageCtrlWheelResizesIt, Source={StaticResource UiText}}">
                            <FontIcon Glyph="&#xEB9F;" FontSize="{StaticResource IconGlyphSize}" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="SignToolButton"
                            Style="{StaticResource IconToggleButtonStyle}"
                            Click="SignToolButton_Click"
                            IsEnabled="False"
                            AutomationProperties.Name="{Binding Sign, Source={StaticResource UiText}}"
                            ToolTipService.ToolTip="{Binding SignPlaceYourSignature, Source={StaticResource UiText}}">
                            <FontIcon Glyph="&#xEE56;" FontSize="{StaticResource IconGlyphSize}" />
                        </ToggleButton>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource HeaderSeparatorStyle}" />
                    <ToggleSplitButton x:Name="CaptureModeButton" Grid.Column="2" Click="CaptureTool_Click"
                                       Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                            <Path x:Name="RectCaptureIcon" Data="M2,4 H18 V16 H2 Z"
                                  Stroke="{Binding Foreground, ElementName=CaptureLabel}"
                                  Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round" />
                            <Path x:Name="FreeCaptureIcon" Visibility="Collapsed"
                                  Data="M13,15 C17,14 19,10 17,6 C15,2 8,2 4,6 C0,10 2,15 7,16 C11,17 14,15 12,13 C10,11 7,13 8,16 C9,19 13,19 15,17"
                                  Stroke="{Binding Foreground, ElementName=CaptureLabel}"
                                  Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round" />
                            <TextBlock x:Name="CaptureLabel" VerticalAlignment="Center" />
                        </StackPanel>
                        <ToggleSplitButton.Flyout>
                            <Flyout x:Name="CaptureModeFlyout" Placement="BottomEdgeAlignedLeft">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="Padding" Value="4" />
                                        <Setter Property="Background" Value="{ThemeResource HomeCardBrush}" />
                                        <Setter Property="CornerRadius" Value="{StaticResource ReaderToolbarRadius}" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <StackPanel Spacing="2" Loaded="CaptureMenu_Loaded">
                                    <RadioButton x:Name="RectCaptureItem" GroupName="ScreenshotMode"
                                                 Style="{StaticResource PageLayoutSegmentStyle}" IsEnabled="True" Height="36"
                                                 HorizontalContentAlignment="Left" Padding="8,0"
                                                 CornerRadius="{StaticResource RadiusSmall}"
                                                 Tag="{Binding RectangleCapture, Source={StaticResource UiText}}"
                                                 AutomationProperties.Name="{Binding RectangleCapture, Source={StaticResource UiText}}"
                                                 Click="CaptureMode_Click">
                                        <RectangleGeometry Rect="2,4,16,12" />
                                    </RadioButton>
                                    <RadioButton x:Name="FreeCaptureItem" GroupName="ScreenshotMode"
                                                 Style="{StaticResource PageLayoutSegmentStyle}" IsEnabled="True" Height="36"
                                                 HorizontalContentAlignment="Left" Padding="8,0"
                                                 CornerRadius="{StaticResource RadiusSmall}"
                                                 Tag="{Binding FreehandCapture, Source={StaticResource UiText}}"
                                                 AutomationProperties.Name="{Binding FreehandCapture, Source={StaticResource UiText}}"
                                                 Click="CaptureMode_Click">
                                        <PathGeometry>
                <PathFigure StartPoint="13,15" IsClosed="False" IsFilled="False">
                    <BezierSegment Point1="17,14" Point2="19,10" Point3="17,6" />
                    <BezierSegment Point1="15,2" Point2="8,2" Point3="4,6" />
                    <BezierSegment Point1="0,10" Point2="2,15" Point3="7,16" />
                    <BezierSegment Point1="11,17" Point2="14,15" Point3="12,13" />
                    <BezierSegment Point1="10,11" Point2="7,13" Point3="8,16" />
                    <BezierSegment Point1="9,19" Point2="13,19" Point3="15,17" />
                </PathFigure>
            </PathGeometry>
                                    </RadioButton>
                                </StackPanel>
                            </Flyout>
                        </ToggleSplitButton.Flyout>
                    </ToggleSplitButton>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource ReaderSideGroupStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ReaderSaveButton" Style="{StaticResource IconButtonStyle}" IsEnabled="False"
                            Click="ReaderSaveButton_Click" AutomationProperties.Name="{Binding Save, Source={StaticResource UiText}}"
                            ToolTipService.ToolTip="{Binding SaveCtrlS, Source={StaticResource UiText}}">
                        <FontIcon Glyph="&#xE74E;" FontSize="{StaticResource IconGlyphSize}" />
                    </Button>
                    <Border x:Name="ReaderSaveSeparator" Style="{StaticResource HeaderSeparatorStyle}" Margin="0" />
                    <Button x:Name="DocumentActionsButton" Style="{StaticResource ReaderSideToolButtonStyle}"
                            AutomationProperties.Name="{Binding DocumentActions, Source={StaticResource UiText}}"
                            ToolTipService.ToolTip="{Binding DocumentActions, Source={StaticResource UiText}}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DocumentActionsLabel, Source={StaticResource UiText}}" VerticalAlignment="Center" />
                            <FontIcon x:Name="DocumentActionsChevron" Glyph="&#xE70D;" FontSize="9" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout x:Name="DocumentActionsFlyout" Placement="BottomEdgeAlignedRight"
                                        Opened="ReaderSideFlyout_Opened" Closed="ReaderSideFlyout_Closed">
                                <MenuFlyout.MenuFlyoutPresenterStyle>
                                    <Style TargetType="MenuFlyoutPresenter">
                                        <Setter Property="Background" Value="{ThemeResource HomeCardBrush}" />
                                    </Style>
                                </MenuFlyout.MenuFlyoutPresenterStyle>
                                <MenuFlyoutItem x:Name="ReaderSaveAsItem" Text="{Binding SaveAs, Source={StaticResource UiText}}"
                                                Click="SaveAsButton_Click" KeyboardAcceleratorTextOverride="Ctrl+Shift+S">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE792;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="CompressExportItem" Text="{Binding CompressExport, Source={StaticResource UiText}}" Click="CompressExport_Click">
                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Download" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="FindItem" Text="{Binding FindInDocument, Source={StaticResource UiText}}"
                                                Click="FindButton_Click" KeyboardAcceleratorTextOverride="Ctrl+F">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="PrintItem" Text="{Binding Print, Source={StaticResource UiText}}"
                                                Click="PrintButton_Click" KeyboardAcceleratorTextOverride="Ctrl+P">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE749;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="CopyPdfFileItem" Text="{Binding CopyPdfFile, Source={StaticResource UiText}}"
                                                Click="CopyPdfFileItem_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="CopyFilePathItem" Text="{Binding CopyFilePath, Source={StaticResource UiText}}"
                                                Click="CopyFilePathItem_Click">
                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Link" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="FlattenItem" Text="{Binding FlattenAnnotations, Source={StaticResource UiText}}"
                                                Click="FlattenButton_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C4;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="DocumentInfoItem" Text="{Binding DocumentInformation, Source={StaticResource UiText}}"
                                                Click="PropertiesButton_Click" KeyboardAcceleratorTextOverride="Ctrl+D">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutSubItem Text="{Binding Help, Source={StaticResource UiText}}">
                                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE897;" /></MenuFlyoutSubItem.Icon>
                                    <MenuFlyoutItem Text="{Binding FindACommand, Source={StaticResource UiText}}"
                                                    Click="PaletteMenuItem_Click" KeyboardAcceleratorTextOverride="Ctrl+K">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="{Binding KeyboardShortcuts, Source={StaticResource UiText}}"
                                                    Click="ShortcutsMenuItem_Click" KeyboardAcceleratorTextOverride="F1">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE765;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="{Binding ReportAProblem, Source={StaticResource UiText}}" Click="ReportProblemMenuItem_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE939;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyoutSubItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="Workspace" Grid.Row="2">
            <!-- The selected tab's DocumentView is swapped in here. -->
            <Border Padding="4" Background="{ThemeResource ReaderWorkspaceBrush}"
                    Visibility="{Binding Visibility, ElementName=DocHost}">
                <ContentControl
                    x:Name="DocHost"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
            </Border>

            <Grid x:Name="StartPage" Margin="4" Padding="28,0" CornerRadius="6"
                  Background="{ThemeResource HomeCanvasBrush}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="RecentsHeading" Grid.ColumnSpan="2" Margin="8,24,8,18"
                      ColumnSpacing="{StaticResource SpaceM}" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <RadioButton Content="{Binding Recent, Source={StaticResource UiText}}" GroupName="ShelfSection" Style="{StaticResource ShelfSectionStyle}"
                                     IsChecked="True" Checked="ShelfSection_Checked" />
                        <RadioButton x:Name="FavoritesTab" Content="{Binding Favorites, Source={StaticResource UiText}}" GroupName="ShelfSection"
                                     Style="{StaticResource ShelfSectionStyle}" Checked="ShelfSection_Checked" />
                    </StackPanel>
                    <Border x:Name="RecentSelectionGroup" Grid.Column="1" VerticalAlignment="Center"
                            Background="{ThemeResource HomeCardBrush}" CornerRadius="{StaticResource RadiusMedium}">
