                                                AutomationProperties.Name="{Binding OrganizePages, Source={StaticResource UiText}}"
                                                ToolTipService.ToolTip="{Binding OrganizePages, Source={StaticResource UiText}}">
                                            <StackPanel Spacing="{StaticResource SpaceS}">
                                                <Border Style="{StaticResource ReaderViewTileIconStyle}">
                                                    <FontIcon Glyph="&#xE179;" FontSize="20" />
                                                </Border>
                                                <TextBlock Text="{Binding OrganizePages, Source={StaticResource UiText}}" Style="{StaticResource ReaderViewTileLabelStyle}" />
