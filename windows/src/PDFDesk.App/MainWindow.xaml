                                            <StackPanel Spacing="{StaticResource SpaceS}">
                                                <Border Style="{StaticResource ReaderViewTileIconStyle}">
                                                    <FontIcon Glyph="&#xE718;" FontSize="20" />
                                                </Border>
                                                <TextBlock Text="{Binding PageBookmarkLabel, Source={StaticResource UiText}}" Style="{StaticResource ReaderViewTileLabelStyle}" />
