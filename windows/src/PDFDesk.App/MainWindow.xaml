                                        </Button>
                                    </Grid>
                                    <Border Height="1" Margin="0,4,0,2" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <TextBlock Text="{Binding PageManagement, Source={StaticResource UiText}}" Style="{StaticResource ViewPanelHeadingStyle}" />
                                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="{StaticResource SpaceXS}">
                                        <Button x:Name="OrganizePagesButton" Style="{StaticResource ReaderViewActionStyle}"
