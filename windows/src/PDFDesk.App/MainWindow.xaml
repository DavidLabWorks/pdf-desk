                            <ScrollViewer x:Name="RecentSelectionReveal" Width="0" Visibility="Collapsed" IsTabStop="False"
                                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="RecentSelectionBar" Orientation="Horizontal" VerticalAlignment="Center"
                                            Height="{StaticResource HeaderHeight}" Padding="12,0,4,0" Spacing="8">
                                    <CheckBox x:Name="AllRecentBox" MinWidth="0" Content="{Binding SelectAllPages, Source={StaticResource UiText}}"
                                              Click="AllRecent_Click" />
                                    <TextBlock x:Name="RecentSelectionCount" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource HomeSecondaryTextBrush}" AutomationProperties.LiveSetting="Polite" />
                                    <Border Style="{StaticResource HeaderSeparatorStyle}" />
                                    <CheckBox x:Name="AlsoDeleteRecentFiles" MinWidth="0" Content="{Binding AlsoDeleteFiles, Source={StaticResource UiText}}"
                                              Click="AlsoDeleteRecentFiles_Click" />
                                    <Button x:Name="RemoveSelectedRecent" styles:DestructiveAction.IsEnabled="True" Style="{StaticResource ReaderSideToolButtonStyle}" MinWidth="0" Padding="8,0"
                                            Click="RemoveSelectedRecent_Click" ToolTipService.ToolTip="{Binding RemoveRecentHint, Source={StaticResource UiText}}"
                                            AutomationProperties.Name="{Binding RemoveFromList, Source={StaticResource UiText}}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                            <TextBlock x:Name="RecentRemovalLabel" Text="{Binding RemovePages, Source={StaticResource UiText}}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                            <ToggleButton x:Name="RecentSelectionMode" VerticalAlignment="Center"
                                          Width="{StaticResource HeaderHeight}" Height="{StaticResource HeaderHeight}"
                                          Background="Transparent" CornerRadius="{StaticResource RadiusMedium}"
                                          Style="{StaticResource IconToggleButtonStyle}" Click="RecentSelectionMode_Click"
                                          AutomationProperties.Name="{Binding ManageRecent, Source={StaticResource UiText}}"
                                          ToolTipService.ToolTip="{Binding ManageRecent, Source={StaticResource UiText}}">
                                <ToggleButton.Resources>
                                    <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorTransparentBrush" />
                                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush" />
                                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorSecondaryBrush" />
                                    <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="AccentTextFillColorPrimaryBrush" />
                                    <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="AccentTextFillColorPrimaryBrush" />
                                    <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="AccentTextFillColorPrimaryBrush" />
                                </ToggleButton.Resources>
                                <FontIcon Glyph="&#xE762;" FontSize="18" />
                            </ToggleButton>
                        </StackPanel>
                    </Border>
