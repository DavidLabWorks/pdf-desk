<Window
    x:Class="PDFDesk.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:styles="using:PDFDesk.Styles"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PDFDesk.Controls">

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource HomeNavigationBrush}"
        AllowDrop="True"
        KeyboardAcceleratorPlacementMode="Hidden"
        DragOver="RootGrid_DragOver"
        Drop="RootGrid_Drop">
        <Grid.Resources>
            <Storyboard x:Name="FavoritesTabPulse" Completed="FavoritesTabPulse_Completed">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                    <LinearDoubleKeyFrame KeyTime="0" Value="0.16" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.09" Value="0.04" KeySpline="0.42,0 0.58,1" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="0.14" KeySpline="0.42,0 0.58,1" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.27" Value="0.03" KeySpline="0.42,0 0.58,1" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.36" Value="0.12" KeySpline="0.42,0 0.58,1" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.47" Value="0" KeySpline="0.42,0 0.58,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <x:Double x:Key="CompactReaderPanelWidth">36</x:Double>
            <x:Double x:Key="ExpandedReaderPanelWidth">318</x:Double>
            <DataTemplate x:Key="FavoriteLocationTemplate">
                <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="8" MinHeight="40" Padding="2,0">
                    <FontIcon Glyph="{Binding Glyph}" FontSize="17" Visibility="{Binding GlyphVisibility}" />
                    <Grid Width="24" Height="20" Visibility="{Binding FolderVisibility}" IsHitTestVisible="False">
                        <Path Data="M1,4 Q1,2 3,2 L9,2 L12,5 L20,5 Q22,5 22,7 L22,15 L1,15 Z"
                              Fill="{ThemeResource ShelfFolderIconBrush}" Opacity="0.65" />
                        <Path Data="M1,8 Q1,7 3,7 L21,7 Q23,7 23,9 L22,17 Q22,18 20,18 L3,18 Q1,18 1,16 Z"
                              Fill="{ThemeResource ShelfFolderIconBrush}" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{Binding Name}" />
                    <TextBlock Grid.Column="2" Text="{Binding Count}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </DataTemplate>
            <Style x:Key="FavoriteLocationStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="8,0" />
            </Style>
            <Style x:Key="FolderNavigationItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource FavoriteLocationStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,1,12,1" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters><Setter Target="RowFill.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" /></VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters><Setter Target="RowFill.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" /></VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="RowFill.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <Setter Target="RowFill.Opacity" Value="{ThemeResource FolderSelectedOpacity}" />
                                                <Setter Target="RowContent.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <VisualState.Setters>
                                                <Setter Target="RowFill.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <Setter Target="RowFill.Opacity" Value="{ThemeResource FolderHoverOpacity}" />
                                                <Setter Target="RowContent.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <VisualState.Setters>
                                                <Setter Target="RowFill.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <Setter Target="RowFill.Opacity" Value="{ThemeResource FolderPressedOpacity}" />
                                                <Setter Target="RowContent.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="RowFill" Height="44" VerticalAlignment="Top" CornerRadius="7" />
                                <ContentPresenter x:Name="RowContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="UnsavedDocumentsTemplate">
                <StackPanel Spacing="12" MaxWidth="380" MinWidth="258">
                    <TextBlock Text="{Binding DiscardChangesHint, Source={StaticResource UiText}}"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ScrollViewer MaxHeight="148" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                        <ItemsControl ItemsSource="{Binding}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="0,4">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </DataTemplate>
            <ControlTemplate x:Key="OpenChoiceTemplate" TargetType="MenuFlyoutItem">
                <Grid x:Name="Surface" Margin="4,2" Padding="8,0" Background="Transparent" CornerRadius="4">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters><Setter Target="Surface.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" /></VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters><Setter Target="Surface.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" /></VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{TemplateBinding Icon}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{TemplateBinding Text}" FontSize="14" />
                        <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </ControlTemplate>
            <MenuFlyout x:Key="OpenChoices">
                <MenuFlyoutItem Text="{Binding OpenOriginal, Source={StaticResource UiText}}" Click="OpenOriginal_Click" Template="{StaticResource OpenChoiceTemplate}"
                                Tag="{Binding EditTheFileInPlace, Source={StaticResource UiText}}">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="{Binding CopyToLibrary, Source={StaticResource UiText}}" Click="CopyToLibrary_Click" Template="{StaticResource OpenChoiceTemplate}"
                                Tag="{Binding KeepASeparateCopy, Source={StaticResource UiText}}">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="{Binding CreateBlankPdf, Source={StaticResource UiText}}" Click="CreateBlankPdf_Click" Template="{StaticResource OpenChoiceTemplate}"
                                Tag="{Binding SaveInLibrary, Source={StaticResource UiText}}">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C3;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="{Binding NewWindow, Source={StaticResource UiText}}" Click="NewWindow_Click" KeyboardAcceleratorTextOverride="Ctrl+N">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE78B;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
            <ControlTemplate x:Key="DocumentTabTemplate" TargetType="TabViewItem">
                <Grid x:Name="LayoutRoot" Background="Transparent">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters><Setter Target="Surface.Background" Value="{ThemeResource HomeCanvasBrush}" /></VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters><Setter Target="Surface.Background" Value="{ThemeResource HomeSectionBrush}" /></VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters><Setter Target="Selection.Opacity" Value="1" /></VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOverSelected">
                                <VisualState.Setters><Setter Target="Selection.Opacity" Value="1" /></VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PressedSelected">
                                <VisualState.Setters><Setter Target="Selection.Opacity" Value="1" /></VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid Height="34" VerticalAlignment="Center" CornerRadius="8">
                        <Border x:Name="Surface" Background="{ThemeResource HomeLayerBrush}" />
                        <Grid x:Name="Selection" Opacity="0" Background="{ThemeResource DocumentTabSelectedFill}">
                            <Border BorderBrush="{ThemeResource DocumentTabSelectedStroke}" BorderThickness="1" CornerRadius="8" />
                        </Grid>
                        <Grid Padding="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{TemplateBinding Header}" TextTrimming="CharacterEllipsis"
                                       FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource HomeTextBrush}" />
                            <Button x:Name="CloseButton" Grid.Column="1" Width="24" Height="24" MinWidth="0" MinHeight="0"
                                    VerticalAlignment="Center" Padding="0" IsTabStop="False" Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon Glyph="&#xE711;" FontSize="10" />
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </ControlTemplate>
            <x:Double x:Key="TitleButtonWidth">48</x:Double>
            <x:Double x:Key="TitleButtonVisualHeight">38</x:Double>
            <CornerRadius x:Key="TitleButtonCornerRadius">7</CornerRadius>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Chrome-style: the tab strip IS the title bar. Tabs carry no
             content (documents render in DocHost below); the footer is the
             window drag region, padded clear of the caption buttons. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <Grid x:Name="StripSpace" SizeChanged="StripSpace_SizeChanged">
        <Grid x:Name="StripGroup" HorizontalAlignment="Left" ColumnDefinitions="*,Auto">
        <TabView
            x:Name="Tabs"
            VerticalAlignment="Center"
            Padding="0,4"
            TabWidthMode="SizeToContent"
            IsAddTabButtonVisible="False"
            CloseButtonOverlayMode="Always"
            SelectionChanged="Tabs_SelectionChanged"
            TabCloseRequested="Tabs_TabCloseRequested">
            <TabView.Resources>
                <ResourceDictionary>
                    <x:Double x:Key="TabViewItemMaxWidth">200</x:Double>
                    <x:Double x:Key="TabViewItemMinWidth">112</x:Double>
                    <Style x:Key="TabViewScrollButtonStyle" TargetType="RepeatButton">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                    <Thickness x:Key="TabViewItemLeftScrollButtonContainerPadding">0</Thickness>
                    <Thickness x:Key="TabViewItemRightScrollButtonContainerPadding">0</Thickness>
                    <SolidColorBrush x:Key="TabViewBorderBrush" Color="Transparent" />
                </ResourceDictionary>
            </TabView.Resources>
            <TabView.TabStripHeader>
                <StackPanel x:Name="StripHeader" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12" Margin="12,0,4,0" SizeChanged="StripSpace_SizeChanged">
                    <Image Width="24" Height="24" VerticalAlignment="Center"
                           Source="ms-appx:///Assets/Square44x44Logo.targetsize-256.png"
                           AutomationProperties.Name="PDF Desk" />
                    <Button x:Name="HomeButton" Click="HomeButton_Click" IsTabStop="False"
                            VerticalAlignment="Center" Background="Transparent"
                            AutomationProperties.Name="{Binding Home, Source={StaticResource UiText}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter Background="Transparent" Content="{TemplateBinding Content}" />
                            </ControlTemplate>
                        </Button.Template>
                        <Grid Width="{StaticResource TitleButtonWidth}" Height="{StaticResource TouchTargetMin}">
                            <Border x:Name="HomeSelection" Height="{StaticResource TitleButtonVisualHeight}"
                                    VerticalAlignment="Center" CornerRadius="{StaticResource TitleButtonCornerRadius}"
                                    BorderThickness="1" BorderBrush="{ThemeResource HomeOutlineBrush}"
                                    Background="{ThemeResource HomeCanvasBrush}" />
                            <FontIcon Glyph="&#xE80F;" FontSize="18"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </Button>
                </StackPanel>
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <Grid x:Name="DragStart" MinWidth="1" />
            </TabView.TabStripFooter>
        </TabView>
        <Button x:Name="NewDocumentButton" Grid.Column="1" Width="34" Height="34" Margin="0,0,16,0"
                VerticalAlignment="Center" Padding="0" Style="{StaticResource SubtleButtonStyle}"
                AutomationProperties.Name="{Binding OpenOrCreatePdf, Source={StaticResource UiText}}" ToolTipService.ToolTip="{Binding OpenOrCreatePdfShortcut, Source={StaticResource UiText}}" Click="OpenButton_Click">
            <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Button>
        </Grid>
        </Grid>
        <StackPanel x:Name="CaptionButtons" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Width" Value="{StaticResource TitleButtonWidth}" />
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="Surface" Background="Transparent">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="HoverFill.Opacity" Value="1" />
                                                    <Setter Target="GlyphHost.Foreground" Value="{ThemeResource CaptionHoverForegroundBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="HoverFill.Opacity" Value="1" />
                                                    <Setter Target="HoverFill.Background" Value="{ThemeResource CaptionPressedBrush}" />
                                                    <Setter Target="GlyphHost.Foreground" Value="{ThemeResource CaptionHoverForegroundBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Border x:Name="HoverFill" Height="{StaticResource TitleButtonVisualHeight}"
                                            CornerRadius="{StaticResource TitleButtonCornerRadius}" VerticalAlignment="Center" Background="{TemplateBinding Background}" Opacity="0" />
                                    <ContentPresenter x:Name="GlyphHost" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Resources>
            <Button x:Name="FocusReadingButton" Visibility="Collapsed" Background="{ThemeResource CaptionHoverBrush}"
                    Click="FocusReadingButton_Click">
                <Grid Width="{StaticResource TitleButtonWidth}" Height="{StaticResource TitleButtonVisualHeight}">
                    <Border x:Name="FocusReadingHighlight" Visibility="Collapsed" Background="{ThemeResource AccentFillColorSecondaryBrush}"
                            Opacity="0.18" CornerRadius="{StaticResource TitleButtonCornerRadius}" />
                    <Path Width="17" Height="14" Stretch="Uniform" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.25"
                          Data="M2,1 H16 Q17,1 17,2 V12 Q17,13 16,13 H2 Q1,13 1,12 V2 Q1,1 2,1 Z M1,4.5 H17" />
                </Grid>
            </Button>
            <Button x:Name="GlobalSettingsButton" Background="{ThemeResource CaptionHoverBrush}" Click="SettingsButton_Click"
                    AutomationProperties.Name="{Binding Settings, Source={StaticResource UiText}}" ToolTipService.ToolTip="{Binding Settings, Source={StaticResource UiText}}">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
            <Button Background="{ThemeResource CaptionMinimizeHoverBrush}" AutomationProperties.Name="{Binding Minimize, Source={StaticResource UiText}}" Click="MinimizeCaption_Click">
                <Path Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.1" Data="M0,0.5 H11" />
            </Button>
            <Button x:Name="MaximizeCaption" Background="{ThemeResource CaptionHoverBrush}" AutomationProperties.Name="{Binding Maximize, Source={StaticResource UiText}}" Click="MaximizeCaption_Click">
                <Grid Width="12" Height="12">
                    <Path x:Name="MaximizeMark" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.1"
                          Data="M1,1 H11 V11 H1 Z" />
                    <Path x:Name="RestoreMark" Visibility="Collapsed" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.1"
                          Data="M3.5,1 H11 V8.5 M1,3.5 H8.5 V11 H1 Z" />
                </Grid>
            </Button>
            <Button Background="{ThemeResource CaptionCloseHoverBrush}" AutomationProperties.Name="{Binding Close, Source={StaticResource UiText}}" Click="CloseCaption_Click">
                <Button.Resources>


                    <SolidColorBrush x:Key="CaptionHoverForegroundBrush" Color="{ThemeResource CaptionCloseGlyphColor}" />
                    <SolidColorBrush x:Key="CaptionPressedBrush" Color="{ThemeResource CaptionClosePressedColor}" />
                </Button.Resources>
                <PathIcon Width="12" Height="12" Data="M0,0.8 L0.8,0 6,5.2 11.2,0 12,0.8 6.8,6 12,11.2 11.2,12 6,6.8 0.8,12 0,11.2 5.2,6 Z" />
            </Button>
        </StackPanel>
        </Grid>

        <Grid x:Name="Toolbar" Grid.Row="1" Visibility="Collapsed"
              Margin="{StaticResource ReaderToolbarMargin}" ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="{StaticResource ReaderToolbarGroupGap}">
            <Grid.Resources>
                <ResourceDictionary Source="ms-appx:///Styles/ReaderToolbarFeedback.xaml" />
            </Grid.Resources>
            <Border Style="{StaticResource ReaderSideGroupStyle}">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="SidebarButton" Style="{StaticResource IconToggleButtonStyle}" IsEnabled="False"
                                  Click="SidebarButton_Click"
                                  AutomationProperties.Name="{Binding ToggleSidebar, Source={StaticResource UiText}}"
                                  ToolTipService.ToolTip="{Binding ToggleSidebarF9, Source={StaticResource UiText}}">
                        <FontIcon Glyph="&#xE8A0;" FontSize="{StaticResource IconGlyphSize}" />
                    </ToggleButton>
                    <Border Style="{StaticResource HeaderSeparatorStyle}" Margin="0" />
                    <Button x:Name="ViewActionsButton" Style="{StaticResource ReaderSideToolButtonStyle}" IsEnabled="False"
                            AutomationProperties.Name="{Binding ViewOptions, Source={StaticResource UiText}}"
                            ToolTipService.ToolTip="{Binding ViewOptions, Source={StaticResource UiText}}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ViewActionsLabel, Source={StaticResource UiText}}" VerticalAlignment="Center" />
                            <FontIcon x:Name="ViewActionsChevron" Glyph="&#xE70D;" FontSize="9" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="ViewActionsFlyout" Placement="BottomEdgeAlignedLeft"
                                    Opened="ReaderSideFlyout_Opened" Closed="ReaderSideFlyout_Closed">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Background" Value="{ThemeResource HomeCardBrush}" />
                                        <Setter Property="BorderBrush" Value="{ThemeResource HomeOutlineBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="CornerRadius" Value="{StaticResource ReaderToolbarRadius}" />
                                        <Setter Property="Padding" Value="16" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <StackPanel Width="324" Spacing="{StaticResource SpaceS}">
                                    <StackPanel.Resources>
                                        <Style x:Key="ViewPanelHeadingStyle" TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="{ThemeResource HomeSecondaryTextBrush}" />
                                        </Style>
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource ReaderToggleCheckedColor}" />
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource ReaderToggleCheckedHoverColor}" />
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource ReaderToggleCheckedHoverColor}" />
                                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource ReaderToggleTextColor}" />
                                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource ReaderToggleTextColor}" />
                                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource ReaderToggleTextColor}" />
                                    </StackPanel.Resources>
                                    <TextBlock Text="{Binding PageLayout, Source={StaticResource UiText}}"
                                               Style="{StaticResource ViewPanelHeadingStyle}" />
                                    <Border Background="{ThemeResource HomeCanvasBrush}" CornerRadius="{StaticResource RadiusMedium}">
                                        <Grid ColumnDefinitions="*,*,*">
                                            <RadioButton x:Name="SinglePageButton" GroupName="PageLayoutMode"
                                                         Style="{StaticResource PageLayoutSegmentStyle}" CornerRadius="8,0,0,8"
                                                         Tag="{Binding SingleColumnLabel, Source={StaticResource UiText}}"
                                                         AutomationProperties.Name="{Binding SinglePageView, Source={StaticResource UiText}}" ToolTipService.ToolTip="{Binding SinglePageView, Source={StaticResource UiText}}"
                                                         IsChecked="True" Checked="PageLayout_Checked">
                                                <RectangleGeometry Rect="5,1,10,14" />
                                            </RadioButton>
                                            <RadioButton x:Name="TwoPageButton" Grid.Column="1" GroupName="PageLayoutMode"
                                                         Style="{StaticResource PageLayoutSegmentStyle}" CornerRadius="0"
                                                         Tag="{Binding DoubleColumnLabel, Source={StaticResource UiText}}"
                                                         AutomationProperties.Name="{Binding TwoPageView, Source={StaticResource UiText}}" ToolTipService.ToolTip="{Binding TwoPageView, Source={StaticResource UiText}}"
                                                         Checked="PageLayout_Checked">
                                                <GeometryGroup>
                                                    <RectangleGeometry Rect="1,1,18,14" />
                                                    <LineGeometry StartPoint="10,1" EndPoint="10,15" />
                                                </GeometryGroup>
                                            </RadioButton>
                                            <RadioButton x:Name="ThreePageButton" Grid.Column="2" GroupName="PageLayoutMode"
                                                         Style="{StaticResource PageLayoutSegmentStyle}" CornerRadius="0,8,8,0"
                                                         Tag="{Binding TripleColumnLabel, Source={StaticResource UiText}}"
                                                         AutomationProperties.Name="{Binding ThreePageView, Source={StaticResource UiText}}"
                                                         ToolTipService.ToolTip="{Binding ThreePageView, Source={StaticResource UiText}}"
                                                         Checked="PageLayout_Checked">
                                                <GeometryGroup>
                                                    <RectangleGeometry Rect="1,1,18,14" />
                                                    <LineGeometry StartPoint="7,1" EndPoint="7,15" />
                                                    <LineGeometry StartPoint="13,1" EndPoint="13,15" />
                                                </GeometryGroup>
                                            </RadioButton>
                                        </Grid>
                                    </Border>
                                    <Border Height="1" Margin="0,4,0,2" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <TextBlock Text="{Binding ReaderDisplayOptions, Source={StaticResource UiText}}" Style="{StaticResource ViewPanelHeadingStyle}" />
                                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="{StaticResource SpaceXS}">
                                        <ToggleButton x:Name="FitWidthItem" Style="{StaticResource ReaderViewActionStyleToggle}"
                                                Click="FitWidthButton_Click"
                                                AutomationProperties.Name="{Binding FitWidth, Source={StaticResource UiText}}"
                                                ToolTipService.ToolTip="{Binding FitWidthCtrl2, Source={StaticResource UiText}}">
                                            <StackPanel Spacing="{StaticResource SpaceS}">
                                                <Border Style="{StaticResource ReaderViewTileIconStyle}">
                                                    <FontIcon Glyph="&#xE9A6;" FontSize="20" />
                                                </Border>
                                                <TextBlock Text="{Binding FitWidth, Source={StaticResource UiText}}" Style="{StaticResource ReaderViewTileLabelStyle}" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton x:Name="FitPageItem" Grid.Column="1" Style="{StaticResource ReaderViewActionStyleToggle}"
                                                Click="FitPageButton_Click"
                                                AutomationProperties.Name="{Binding FitPage, Source={StaticResource UiText}}"
                                                ToolTipService.ToolTip="{Binding FitPageCtrl0, Source={StaticResource UiText}}">
                                            <StackPanel Spacing="{StaticResource SpaceS}">
                                                <Border Style="{StaticResource ReaderViewTileIconStyle}">
                                                    <FontIcon Glyph="&#xE9A6;" FontSize="20" RenderTransformOrigin="0.5,0.5">
                                                        <FontIcon.RenderTransform><RotateTransform Angle="90" /></FontIcon.RenderTransform>
                                                    </FontIcon>
                                                </Border>
                                                <TextBlock Text="{Binding FitPage, Source={StaticResource UiText}}" Style="{StaticResource ReaderViewTileLabelStyle}" />
                                            </StackPanel>
                                        </ToggleButton>
