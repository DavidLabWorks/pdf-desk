<!-- Shared control styles for the Papers-style chrome. Every header/pill/
     sidebar control uses one of these — no inline one-off styling. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:styles="using:PDFDesk.Styles"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DestructiveDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="styles:DestructiveAction.IsEnabled" Value="True" />
    </Style>

    <!-- Flat square icon button (GNOME headerbar button proportions). -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="IconSegmentStyle" TargetType="RadioButton">
        <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <Setter Target="PageIcon.Stroke" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters><Setter Target="Feedback.Opacity" Value="0.07" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="Feedback.Opacity" Value="0.12" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters><Setter Target="PageIcon.Opacity" Value="0.45" /></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Surface" CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border x:Name="Feedback" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource HomeTextBrush}" Opacity="0" />
                        <Path x:Name="PageIcon" Width="20" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                              StrokeThickness="1.4" Stroke="{ThemeResource HomeTextBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageLayoutSegmentStyle" TargetType="RadioButton">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Height" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <Setter Target="PageIcon.Stroke" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        <Setter Target="SegmentLabel.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters><Setter Target="Feedback.Opacity" Value="0.07" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="Feedback.Opacity" Value="0.12" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="PageIcon.Opacity" Value="0.45" />
                                        <Setter Target="SegmentLabel.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Surface" CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border x:Name="Feedback" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource HomeTextBrush}" Opacity="0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                            <Path x:Name="PageIcon" Width="20" Height="16" VerticalAlignment="Center"
                                  Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                  StrokeThickness="1.4" Stroke="{ThemeResource HomeTextBrush}" />
                            <TextBlock x:Name="SegmentLabel" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{ThemeResource HomeTextBrush}" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShelfViewSegmentStyle" TargetType="RadioButton" BasedOn="{StaticResource IconSegmentStyle}">
        <Setter Property="Width" Value="{StaticResource HeaderHeight}" />
        <Setter Property="Height" Value="{StaticResource HeaderHeight}" />
    </Style>

    <Style x:Key="ReaderSideGroupStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource HomeCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HomeOutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    </Style>

    <Style x:Key="ReaderSideToolButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    </Style>

    <Style x:Key="ReaderViewActionStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="4,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    </Style>

    <Style x:Key="ReaderViewActionStyleToggle" TargetType="ToggleButton">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="4,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    </Style>

    <Style x:Key="ReaderViewTileIconStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="Height" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{ThemeResource HomeCanvasBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ReaderToolbarRadius}" />
    </Style>

    <Style x:Key="ReaderViewTileLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ZoomControlButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Width" Value="26" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    </Style>

    <Style x:Key="SidebarTabStyle" TargetType="RadioButton">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource HomeNavigationBrush}" />
                                        <Setter Target="Label.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <Setter Target="Label.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters><Setter Target="Feedback.Opacity" Value="0.05" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="Feedback.Opacity" Value="0.10" /></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Surface" CornerRadius="5" />
                        <Border x:Name="Feedback" CornerRadius="5" Background="{ThemeResource HomeTextBrush}" Opacity="0" />
                        <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}"
                                          Foreground="{ThemeResource HomeSecondaryTextBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Floating formatting controls. -->
    <Style x:Key="TextFormatPickerStyle" TargetType="DropDownButton">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{ThemeResource HomeLayerBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    </Style>

    <Style x:Key="TextFormatToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggleButtonStyle}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    </Style>

    <Style x:Key="TextFormatAlignmentLineStyle" TargetType="Border">
        <Setter Property="Height" Value="1.5" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="PenPanelPresenterStyle" TargetType="FlyoutPresenter">
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ReaderToolbarRadius}" />
        <Setter Property="Background" Value="{ThemeResource HomeCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Pen colour swatch: a filled circle. WinUI clamps corner radius to half
         the smaller side, so 16 is a circle at 32 px. -->
    <Style x:Key="InkSwatchButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource InkSwatchSize}" />
        <Setter Property="Height" Value="{StaticResource InkSwatchSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Pen width choice: shows the actual stroke thickness. -->
    <Style x:Key="InkWidthButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="{StaticResource InkSwatchSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Vertical rule grouping related header buttons. -->
    <Style x:Key="HeaderSeparatorStyle" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="{StaticResource HeaderSeparatorHeight}" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <!-- ================================================================
         Styles for panels built in code-behind.

         Code-behind must NEVER resolve a theme brush itself: reading
         Application.Current.Resources["...Brush"] returns the DARK value
         whatever the active theme is, so light mode silently gets dark
         chrome. A Style is safe because its setters are resolved against
         the element's real theme when it is applied — assign element.Style
         instead of the brush.
         ================================================================ -->

    <!-- Horizontal rule inside a flyout or dialog. -->
    <Style x:Key="FlyoutSeparatorStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <!-- Key cap in the keyboard-shortcuts dialog. -->
    <Style x:Key="ShortcutKeyChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <!-- De-emphasised label text (dialog field names, captions). Replaces
         hardcoded Opacity, which reads very differently on light vs dark. -->
    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="ValidationErrorTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>

    <Style x:Key="TertiaryTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- The box you type into on the page. It sits over the document, so it has
         to disappear into it: no fill, no rounded chrome, just a thin accent
         edge saying where the text will land. Every colour the text itself takes
         is set in code from the chosen ink, so nothing here fixes a foreground. -->
    <Style x:Key="PageTextEditorStyle" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="ContentElement" MinWidth="0" MinHeight="0"
                                  Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                  IsTabStop="False" ZoomMode="Disabled" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    </Style>
</ResourceDictionary>
