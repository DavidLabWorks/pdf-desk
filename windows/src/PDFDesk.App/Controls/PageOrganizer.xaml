<ContentDialog
    x:Class="PDFDesk.Controls.PageOrganizer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:styles="using:PDFDesk.Styles"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PDFDesk.Controls"
    Style="{StaticResource DefaultContentDialogStyle}"
    CornerRadius="{StaticResource ReaderToolbarRadius}"
    AutomationProperties.Name="{Binding OrganizePages, Source={StaticResource UiText}}">
    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <x:Double x:Key="ContentDialogMaxWidth">1080</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
    </ContentDialog.Resources>
    <Grid>
        <ContentControl x:Name="EditorSurface" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False">
            <Grid x:Name="Body" Margin="20" PreviewKeyDown="Body_PreviewKeyDown" RowDefinitions="Auto,Auto,*" RowSpacing="{StaticResource SpaceS}">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{StaticResource SpaceS}" MinHeight="{StaticResource HeaderHeight}">
                    <TextBlock x:Name="Heading" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Style="{StaticResource SubtitleTextBlockStyle}" Text="{Binding OrganizePages, Source={StaticResource UiText}}" />
                    <Button Grid.Column="1" x:Name="SaveCopy" Visibility="Collapsed" Content="{Binding SaveAsAction, Source={StaticResource UiText}}"
                            Height="{StaticResource IconButtonSize}" Click="Command_Click" />
                    <Button Grid.Column="2" x:Name="SaveDraft" Content="{Binding Save, Source={StaticResource UiText}}" Style="{StaticResource AccentButtonStyle}" Height="{StaticResource IconButtonSize}" Padding="16,0"
                            Click="Command_Click" ToolTipService.ToolTip="{Binding SaveCtrlS, Source={StaticResource UiText}}" />
                    <Button x:Name="Dismiss" Grid.Column="3" VerticalAlignment="Center"
                            Style="{StaticResource IconButtonStyle}" Click="Dismiss_Click"
                            AutomationProperties.Name="{Binding Close, Source={StaticResource UiText}}"
                            ToolTipService.ToolTip="{Binding CloseEsc, Source={StaticResource UiText}}">
                        <FontIcon Glyph="&#xE711;" FontSize="{StaticResource IconGlyphSize}" />
                    </Button>
                </Grid>
                <Border Grid.Row="1" Grid.RowSpan="2" Background="{ThemeResource HomeCanvasBrush}" CornerRadius="{StaticResource RadiusMedium}" />
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Padding="12,8" ColumnSpacing="{StaticResource SpaceM}"
                      BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.Resources>
                        <ResourceDictionary Source="ms-appx:///Styles/ReaderToolbarFeedback.xaml" />
                    </Grid.Resources>
                    <Grid x:Name="SelectionSummary" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceM}">
                        <CheckBox x:Name="SelectAllBox" MinWidth="0" IsThreeState="True" Click="SelectAll_Click"
                                  ToolTipService.ToolTip="{Binding SelectAllPagesShortcut, Source={StaticResource UiText}}"
                                  Content="{Binding SelectAllPages, Source={StaticResource UiText}}" />
                        <TextBlock x:Name="Status" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource HomeSecondaryTextBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                    <Border x:Name="ToolsSurface" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                            Style="{StaticResource ReaderSideGroupStyle}" CornerRadius="{StaticResource ReaderToolbarRadius}"
                            Padding="4,1">
                        <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="Undo" Style="{StaticResource IconButtonStyle}" Click="Command_Click"
                                        AutomationProperties.Name="{Binding Undo, Source={StaticResource UiText}}" ToolTipService.ToolTip="{Binding UndoShortcut, Source={StaticResource UiText}}">
                                    <FontIcon Glyph="&#xE7A7;" FontSize="{StaticResource IconGlyphSize}" />
                                </Button>
                                <Button x:Name="Redo" Style="{StaticResource IconButtonStyle}" Click="Command_Click"
                                        AutomationProperties.Name="{Binding Redo, Source={StaticResource UiText}}" ToolTipService.ToolTip="{Binding RedoShortcut, Source={StaticResource UiText}}">
                                    <FontIcon Glyph="&#xE7A6;" FontSize="{StaticResource IconGlyphSize}" />
                                </Button>
                                <Border Style="{StaticResource HeaderSeparatorStyle}" />
                                <Button x:Name="Duplicate" Style="{StaticResource IconButtonStyle}" Click="Command_Click"
                                        AutomationProperties.Name="{Binding DuplicatePages, Source={StaticResource UiText}}" ToolTipService.ToolTip="{Binding DuplicatePagesShortcut, Source={StaticResource UiText}}">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="{StaticResource IconGlyphSize}" />
                                </Button>
                                <Button x:Name="Remove" styles:DestructiveAction.IsEnabled="True" Style="{StaticResource IconButtonStyle}" Click="Command_Click"
                                        AutomationProperties.Name="{Binding RemovePages, Source={StaticResource UiText}}" ToolTipService.ToolTip="{Binding RemovePagesShortcut, Source={StaticResource UiText}}">
                                    <FontIcon Glyph="&#xE74D;" FontSize="{StaticResource IconGlyphSize}" />
                                </Button>
                                <Border Style="{StaticResource HeaderSeparatorStyle}" />
                                <Button x:Name="Earlier" Style="{StaticResource IconButtonStyle}" Click="Command_Click"
                                        AutomationProperties.Name="{Binding MoveEarlier, Source={StaticResource UiText}}" ToolTipService.ToolTip="{Binding MoveEarlierShortcut, Source={StaticResource UiText}}">
                                    <FontIcon Glyph="&#xE72B;" FontSize="{StaticResource IconGlyphSize}" />
                                </Button>
                                <Button x:Name="Later" Style="{StaticResource IconButtonStyle}" Click="Command_Click"
                                        AutomationProperties.Name="{Binding MoveLater, Source={StaticResource UiText}}" ToolTipService.ToolTip="{Binding MoveLaterShortcut, Source={StaticResource UiText}}">
                                    <FontIcon Glyph="&#xE72A;" FontSize="{StaticResource IconGlyphSize}" />
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
                <GridView x:Name="Pages" Grid.Row="2" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="True"
                          CanDragItems="True" AllowDrop="True" DragItemsStarting="Pages_DragStarting"
                          DragLeave="Pages_DragLeave" DragOver="Pages_DragOver" Drop="Pages_Drop" DragItemsCompleted="DragCompleted"
                          SelectionChanged="Selection_Changed" Padding="{StaticResource OrganizerPadding}"
                          Background="Transparent" CornerRadius="{StaticResource RadiusMedium}"
                          AutomationProperties.Name="{Binding OrganizePages, Source={StaticResource UiText}}">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="controls:ThumbnailItem">
                            <StackPanel Padding="{StaticResource OrganizerPadding}" Spacing="{StaticResource SpaceXS}">
                                <Viewbox Width="{StaticResource SidebarThumbWidth}" Height="{StaticResource CardHeight}" Stretch="Uniform">
                                    <Border Width="{StaticResource SidebarThumbWidth}" Height="{x:Bind BoxHeight, Mode=OneWay}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSmall}">
                                        <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="Uniform" />
                                    </Border>
                                </Viewbox>
                                <TextBlock Text="{x:Bind Label, Mode=OneWay}" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <Canvas Grid.Row="2" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                    <Border x:Name="InsertionLine" Width="{StaticResource SpaceXS}" Visibility="Collapsed"
                            CornerRadius="{StaticResource RadiusSmall}" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Grid x:Name="DragBundle" Width="{StaticResource OrganizerDragWidth}" Height="{StaticResource OrganizerDragHeight}"
                          Visibility="Collapsed">
                        <Grid.Resources>
                            <Style x:Key="DragSheetStyle" TargetType="Border">
                                <Setter Property="Background" Value="{ThemeResource HomeCardBrush}" />
                                <Setter Property="BorderBrush" Value="{ThemeResource HomeOutlineBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.9" />
                            </Style>
                        </Grid.Resources>
                        <Border x:Name="ThirdSheet" Style="{StaticResource DragSheetStyle}" Margin="18,7,8,8">
                            <Border.RenderTransform><RotateTransform Angle="7" /></Border.RenderTransform>
                        </Border>
                        <Border Style="{StaticResource DragSheetStyle}" Margin="11,10,15,7">
                            <Border.RenderTransform><RotateTransform Angle="3.5" /></Border.RenderTransform>
                        </Border>
                        <Border Style="{StaticResource DragSheetStyle}" Margin="3,15,23,4" Translation="0,0,8">
                            <Border.Shadow><ThemeShadow /></Border.Shadow>
                            <Grid RowDefinitions="*,Auto" Padding="{StaticResource OrganizerPadding}" RowSpacing="{StaticResource SpaceXS}">
                                <Image x:Name="BundleImage" Stretch="Uniform" />
                                <TextBlock x:Name="BundleDestination" Grid.Row="1" HorizontalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                        </Border>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,3,0" Padding="9,3" Translation="0,0,10"
                                CornerRadius="{StaticResource RadiusMedium}" Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock x:Name="BundleCount" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                    </Grid>
                </Canvas>
            </Grid>
        </ContentControl>
        <Grid x:Name="ConfirmLayer" Visibility="Collapsed" Background="{ThemeResource SmokeFillColorDefaultBrush}"
              CornerRadius="{StaticResource ReaderToolbarRadius}" TabFocusNavigation="Cycle" PreviewKeyDown="Confirm_PreviewKeyDown">
            <Border MaxWidth="388" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource ContentDialogBackground}" BorderBrush="{ThemeResource HomeOutlineBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource ReaderToolbarRadius}" Translation="0,0,24">
                <Border.Shadow><ThemeShadow /></Border.Shadow>
                <StackPanel>
                    <StackPanel Padding="24,20" Spacing="{StaticResource SpaceS}">
                        <TextBlock Text="{Binding SavePageChanges, Source={StaticResource UiText}}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PageChangesHint, Source={StaticResource UiText}}" Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Padding="16,12" ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource SpaceS}"
                          BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                          Background="{ThemeResource HomeCardBrush}">
                        <Button x:Name="ConfirmSave" Content="{Binding Save, Source={StaticResource UiText}}" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" Click="ConfirmSave_Click" />
                        <Button x:Name="ConfirmDiscard" styles:DestructiveAction.IsEnabled="True" Grid.Column="1" Content="{Binding DiscardChanges, Source={StaticResource UiText}}"
                                HorizontalAlignment="Stretch" Click="ConfirmDiscard_Click" />
                        <Button x:Name="ConfirmCancel" Grid.Column="2" Content="{Binding Cancel, Source={StaticResource UiText}}"
                                HorizontalAlignment="Stretch" Click="ConfirmCancel_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ContentDialog>
