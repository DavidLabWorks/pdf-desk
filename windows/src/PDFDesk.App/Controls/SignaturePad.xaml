<UserControl
    x:Class="PDFDesk.Controls.SignaturePad"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:styles="using:PDFDesk.Styles"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Width="420" Spacing="12">
        <SelectorBar x:Name="ModeBar" AutomationProperties.Name="{Binding SignatureMethod, Source={StaticResource UiText}}">
            <SelectorBarItem x:Name="DrawMode" Text="{Binding SignatureDraw, Source={StaticResource UiText}}" IsSelected="True" />
            <SelectorBarItem x:Name="TypeMode" Text="{Binding SignatureType, Source={StaticResource UiText}}" />
            <SelectorBarItem x:Name="ImageMode" Text="{Binding SignatureImage, Source={StaticResource UiText}}" />
        </SelectorBar>
        <!-- The pad is deliberately white in both themes: a signature is ink on
             paper, and drawing it on a dark surface would misrepresent how it
             lands on the page. -->
        <!-- Live strokes are plain XAML Polylines, not a Win2D CanvasControl: a
             Win2D control hosted inside a ContentDialog's popup does not
             reliably get a device and renders nothing. Win2D is still used,
             but only offscreen, to rasterise the finished strokes.

             The Canvas needs a Background to be hit-testable at all. -->
        <Border
            BorderThickness="1"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="White" Height="162">
            <Grid>
                <Canvas
                    x:Name="Pad"
                    Background="White"
                    PointerPressed="Pad_PointerPressed"
                    PointerMoved="Pad_PointerMoved"
                    PointerReleased="Pad_PointerReleased"
                    PointerCanceled="Pad_PointerReleased"
                    PointerCaptureLost="Pad_PointerReleased" />
                <!-- Above the canvas so an import is visible, but transparent to
                     the pointer so drawing still reaches the canvas. -->
                <Image
                    x:Name="ImportedPreview"
                    Stretch="Uniform"
                    Margin="8"
                    IsHitTestVisible="False" />
                <!-- Typed preview. Same reason the live strokes are XAML rather
                     than Win2D: a Win2D control in a dialog popup may never get
                     a device. The family is resolved against the installed set
                     so this shows the same face Rasterize will draw in.

                     Inside a DownOnly Viewbox so a long name shrinks to fit
                     instead of running off the paper — a signature the user
                     cannot see the end of is worse than a smaller one. This
                     scales the preview only; RasterizeTyped measures its own
                     layout, so the stamp's resolution is unaffected. -->
                <TextBlock x:Name="PaperHint" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#606060" IsHitTestVisible="False" />
                <Viewbox
                    Stretch="Uniform"
                    StretchDirection="DownOnly"
                    Margin="14,10"
                    IsHitTestVisible="False">
                    <TextBlock
                        x:Name="TypedPreview"
                        FontSize="64"
                        TextAlignment="Center"
                        TextWrapping="NoWrap" />
                </Viewbox>
            </Grid>
        </Border>

        <Grid Height="76" RowSpacing="6">
            <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="36" /></Grid.RowDefinitions>
            <Grid x:Name="TypeOptions" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="TypedBox" PlaceholderText="{Binding SignatureType, Source={StaticResource UiText}}"
                         AutomationProperties.Name="{Binding SignatureType, Source={StaticResource UiText}}" MaxLength="64" TextChanged="TypedBox_TextChanged" />
                <ComboBox x:Name="TypedStyleBox" Grid.Column="1" MinWidth="116" SelectionChanged="TypedStyleBox_SelectionChanged"
                          AutomationProperties.Name="{Binding HandwritingStyle, Source={StaticResource UiText}}" />
            </Grid>
            <Grid x:Name="ImageOptions">
                <CheckBox x:Name="RemoveBackgroundCheck" Content="{Binding RemoveBackground, Source={StaticResource UiText}}"
                          IsEnabled="False" IsChecked="True" Click="RemoveBackground_Click" />
                <Button HorizontalAlignment="Right" Content="{Binding ChooseSignatureImage, Source={StaticResource UiText}}" Click="ImportButton_Click" />
            </Grid>
            <Grid x:Name="InkOptions">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="BlackButton" Style="{StaticResource InkSwatchButtonStyle}" Click="BlackButton_Click"
                            AutomationProperties.Name="{Binding BlackInk, Source={StaticResource UiText}}" ToolTipService.ToolTip="{Binding Black, Source={StaticResource UiText}}" />
                    <Button x:Name="BlueButton" Style="{StaticResource InkSwatchButtonStyle}" Click="BlueButton_Click"
                            AutomationProperties.Name="{Binding BlueInk, Source={StaticResource UiText}}" ToolTipService.ToolTip="{Binding Blue, Source={StaticResource UiText}}" />
                </StackPanel>
                <Button x:Name="ClearInk" styles:DestructiveAction.IsEnabled="True" HorizontalAlignment="Right" Style="{StaticResource SubtleButtonStyle}" Content="{Binding Clear, Source={StaticResource UiText}}" Click="ClearButton_Click" />
            </Grid>
            <TextBlock x:Name="Caption" Grid.Row="1" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </StackPanel>
</UserControl>
