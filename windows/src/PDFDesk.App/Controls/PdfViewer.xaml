<UserControl
    x:Class="PDFDesk.Controls.PdfViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PDFDesk.Controls"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml">

    <!-- ZoomMode carries pinch only; Ctrl+wheel is handled in code-behind so it
         never raster-scales. MinZoomFactor/MaxZoomFactor must match PdfViewer's
         MinZoom/MaxZoom: if the ScrollViewer clamps a pinch at a limit the real
         zoom hasn't reached, RebaseZoom folds in a factor the zoom can't absorb
         and the anchor drifts at the extremes. -->
    <Grid>
        <ScrollViewer
            x:Name="Scroller"
            Background="{ThemeResource HomeCanvasBrush}"
            ZoomMode="Enabled"
            MinZoomFactor="0.1"
            MaxZoomFactor="6.4"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollMode="Enabled"
            ViewChanged="Scroller_ViewChanged"
            SizeChanged="Scroller_SizeChanged">
            <local:DocumentCanvas x:Name="DocumentExtent" Background="Transparent">
                <win2d:CanvasVirtualControl
                    x:Name="Canvas"
                    RegionsInvalidated="Canvas_RegionsInvalidated"
                    CreateResources="Canvas_CreateResources" />
            </local:DocumentCanvas>
        </ScrollViewer>

        <!-- The text box being typed into, above the page rather than on it.
             A real TextBox brings IME, selection, clipboard and accessibility
             with it; drawing a caret on the Win2D canvas would mean writing all
             of that by hand. It is positioned by margin from the viewer's
             top-left and re-placed on every ViewChanged, so it tracks scroll and
             zoom. NoWrap is deliberate: a PDF text object does not wrap, so a
             box that wrapped on screen would be lying about the result. -->
        <!-- Cover the old stamp while its replacement is being typed. Its height
             must not constrain the live editor when lines are removed. -->
        <Rectangle x:Name="OriginalTextMask" Visibility="Collapsed" Fill="White"
                   IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Grid x:Name="TextEditorFrame" Visibility="Collapsed" MinWidth="12"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBox x:Name="TextEditor" MinHeight="0" MinWidth="0" AcceptsReturn="True"
                     TextWrapping="NoWrap" Padding="2,1" BorderThickness="0"
                     Style="{StaticResource PageTextEditorStyle}"
                     LostFocus="TextEditor_LostFocus" KeyDown="TextEditor_KeyDown" />
            <Rectangle IsHitTestVisible="False" StrokeThickness="1" StrokeDashArray="3,3"
                       Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
        </Grid>
        <Grid x:Name="ScreenshotOverlay" Visibility="Collapsed">
            <local:DocumentCanvas x:Name="CaptureInput" Background="Transparent" ManipulationMode="None"
                    PointerPressed="Capture_Pressed" PointerMoved="Capture_Moved" PointerReleased="Capture_Released"
                    PointerCanceled="Capture_Lost" PointerCaptureLost="Capture_Lost" PointerWheelChanged="Capture_Wheel">
                <Polygon x:Name="CaptureOutline" IsHitTestVisible="False" StrokeThickness="1.75" StrokeLineJoin="Round"
                         Stroke="{ThemeResource AccentFillColorDefaultBrush}">
                    <Polygon.Fill><SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.10" /></Polygon.Fill>
                </Polygon>
            </local:DocumentCanvas>
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="8" Padding="10,2,2,2"
                    Background="{ThemeResource HomeCardBrush}" BorderBrush="{ThemeResource HomeOutlineBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusMedium}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXS}">
                    <TextBlock x:Name="CaptureHint" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Button Style="{StaticResource IconButtonStyle}" Click="CaptureCancel_Click"
                            AutomationProperties.Name="{Binding Cancel, Source={StaticResource UiText}}">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
