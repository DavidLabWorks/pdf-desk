<UserControl
    x:Class="PDFDesk.Controls.DocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PDFDesk.Controls">

    <SplitView
        x:Name="Split"
        DisplayMode="Inline"
        PanePlacement="Left"
        OpenPaneLength="{StaticResource SidebarWidth}"
        Background="Transparent"
        PaneBackground="Transparent"
        IsPaneOpen="False">

        <SplitView.Pane>
            <Grid Margin="{StaticResource ReaderPaneMargin}"
                  Background="{ThemeResource HomeCanvasBrush}"
                  CornerRadius="{StaticResource RadiusMedium}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Pane content: one of thumbnails / chapters / bookmarks -->
                <ListView
                    x:Name="ThumbList"
                    Grid.Row="0"
                    SelectionMode="Extended"
                    Padding="4,8"
                    CanDragItems="True"
                    CanReorderItems="True"
                    AllowDrop="True"
                    ContainerContentChanging="ThumbList_ContainerContentChanging"
                    SelectionChanged="ThumbList_SelectionChanged"
                    DragItemsCompleted="ThumbList_DragItemsCompleted"
                    DragOver="ThumbList_DragOver"
                    Drop="ThumbList_Drop"
                    RightTapped="ThumbList_RightTapped"
                    KeyDown="ThumbList_KeyDown">
                    <ListView.Resources>
                        <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                        <CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius>
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="2,2,2,3" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="controls:ThumbnailItem">
                            <Grid>
                                <Grid Visibility="{x:Bind IsSelected, Mode=OneWay}" IsHitTestVisible="False"
                                      AutomationProperties.AccessibilityView="Raw">
                                    <Border CornerRadius="8" Opacity="0.05"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <Border CornerRadius="8" BorderThickness="2"
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto,*" Padding="0,6">
                                    <TextBlock Grid.Column="0" Margin="2,0,8,0" TextAlignment="Right"
                                               VerticalAlignment="Center" Text="{x:Bind Label, Mode=OneWay}"
                                               FontWeight="{x:Bind LabelWeight, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Border Grid.Column="1" Width="{StaticResource SidebarThumbWidth}"
                                            Height="{x:Bind BoxHeight, Mode=OneWay}" CornerRadius="4"
                                            BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="Uniform" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TreeView
                    x:Name="OutlineTree"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    SelectionMode="Single"
                    Padding="0,8"
                    ItemInvoked="OutlineTree_ItemInvoked">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="controls:OutlineNode">
                            <TreeViewItem
                                ItemsSource="{x:Bind Children}"
                                IsExpanded="False">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <TextBlock
                    x:Name="NoOutlineLabel"
                    Grid.Row="0"
                    Text="{Binding NoTableOfContents, Source={StaticResource UiText}}"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                <!-- Bookmarks pane (user bookmarks; persisted via the shell) -->
                <ListView
                    x:Name="BookmarkList"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    SelectionMode="Single"
                    Padding="8,8"
                    IsItemClickEnabled="True"
                    ItemClick="BookmarkList_ItemClick"
                    RightTapped="BookmarkList_RightTapped"
                    KeyDown="BookmarkList_KeyDown">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="UseSystemFocusVisuals" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ListViewItemPresenter Control.IsTemplateFocusTarget="True"
                                            ContentMargin="12,0" MinHeight="38" CornerRadius="6"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                            SelectionIndicatorVisualEnabled="False"
                                            SelectedBackground="{ThemeResource HomeNavigationBrush}"
                                            SelectedForeground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            SelectedPointerOverBackground="{ThemeResource HomeNavigationBrush}"
                                            PointerOverBackground="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            PressedBackground="{ThemeResource SubtleFillColorTertiaryBrush}"
                                            SelectedPressedBackground="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="controls:BookmarkItem">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                <PathIcon Width="11" Height="14" VerticalAlignment="Center"
                                          Data="F0 M1,0 H12 V16 L6.5,12.5 L1,16 Z M2.5,1.5 V13.3 L6.5,10.8 L10.5,13.3 V1.5 Z" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14"
                                           Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource HomeSecondaryTextBrush}"
                                           Visibility="{x:Bind HasCustomName, Mode=OneWay}"
                                           Text="{x:Bind PageLabel, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel
                    x:Name="NoBookmarksLabel"
                    Grid.Row="0"
                    Spacing="4"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding NoBookmarksYet, Source={StaticResource UiText}}"
                        HorizontalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock
                        Text="{Binding PressCtrlBToBookmarkThisPage, Source={StaticResource UiText}}"
                        HorizontalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorDisabledBrush}" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="8,5,8,7" Padding="3" ColumnSpacing="2"
                      CornerRadius="7" Background="{ThemeResource HomeShelfBrush}" ColumnDefinitions="*,*,*">
                    <RadioButton x:Name="ThumbsTab" Grid.Column="0" IsChecked="True"
                                 Style="{StaticResource SidebarTabStyle}" Checked="SidebarTab_Checked"
                                 AutomationProperties.Name="{Binding PageThumbnails, Source={StaticResource UiText}}"
                                 ToolTipService.ToolTip="{Binding Thumbnails, Source={StaticResource UiText}}">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8A9;" FontSize="13" />
                            <TextBlock Text="{Binding SidebarPages, Source={StaticResource UiText}}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="OutlineTab" Grid.Column="1"
                                 Style="{StaticResource SidebarTabStyle}" Checked="SidebarTab_Checked"
                                 AutomationProperties.Name="{Binding Chapters, Source={StaticResource UiText}}"
                                 ToolTipService.ToolTip="{Binding Chapters, Source={StaticResource UiText}}">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8FD;" FontSize="13" />
                            <TextBlock Text="{Binding Chapters, Source={StaticResource UiText}}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="BookmarksTab" Grid.Column="2"
                                 Style="{StaticResource SidebarTabStyle}" Checked="SidebarTab_Checked"
                                 AutomationProperties.Name="{Binding Bookmarks, Source={StaticResource UiText}}"
                                 ToolTipService.ToolTip="{Binding Bookmarks, Source={StaticResource UiText}}">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <Path Width="13" Height="16" VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, ElementName=BookmarkLabel}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round"
                                  Data="M2,1.5 H11 V14.5 L6.5,11.5 L2,14.5 Z" />
                            <TextBlock x:Name="BookmarkLabel" Text="{Binding Bookmarks, Source={StaticResource UiText}}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </Grid>
            </Grid>
        </SplitView.Pane>

        <!-- SplitView.Content is already the region to the right of the pane,
             so the notice follows the reading column and stays clear of the sidebar. -->
        <Grid x:Name="ReadingColumn" RowDefinitions="Auto,Auto,*,Auto"
              Background="{ThemeResource HomeCanvasBrush}"
              CornerRadius="{StaticResource RadiusMedium}">
            <InfoBar x:Name="MissingSourceBar" Grid.Row="1" Severity="Warning" IsClosable="False"
                     Margin="8,4,8,4" AutomationProperties.LiveSetting="Polite">
                <InfoBar.ActionButton>
                    <Button x:Name="SaveMissingCopy" Click="SaveMissingCopy_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <Grid x:Name="SnapshotBar" Grid.Row="3" Visibility="Collapsed" Padding="8,4" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceXS}">
                <TextBlock x:Name="SnapshotStatus" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="ReloadSnapshot" Click="ReloadSnapshot_Click"/>
            </Grid>
            <Grid Grid.Row="2">
            <controls:PdfViewer x:Name="ViewerControl">
                <controls:PdfViewer.RenderTransform>
                    <TranslateTransform />
                </controls:PdfViewer.RenderTransform>
            </controls:PdfViewer>
            <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="{ThemeResource HomeCanvasBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <ProgressRing x:Name="LoadingRing" IsActive="False" Width="24" Height="24"
                                  AutomationProperties.Name="{Binding LoadingPDF, Source={StaticResource UiText}}" />
                    <TextBlock Text="{Binding LoadingPDFAction, Source={StaticResource UiText}}" Foreground="{ThemeResource HomeSecondaryTextBrush}" />
                </StackPanel>
            </Grid>
            <controls:NoticeHost x:Name="Notice" />
            </Grid>
        </Grid>
    </SplitView>
</UserControl>
