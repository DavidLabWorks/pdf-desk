<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PDFDesk.Engine\PDFDesk.Engine.csproj" />
    <ProjectReference Include="..\..\src\PDFDesk.PdfiumInterop\PDFDesk.PdfiumInterop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\third_party\qpdf\$(NETCoreSdkRuntimeIdentifier)\*" Condition="'$(RuntimeIdentifier)' == ''" Link="Tools\qpdf\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\third_party\qpdf\$(RuntimeIdentifier)\*" Condition="'$(RuntimeIdentifier)' != ''" Link="Tools\qpdf\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Sample PDFs generated by tests/gen-corpus.ps1 -->
    <None Include="..\..\..\tests\corpus\**" Link="corpus\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
