<UserControl
    x:Class="PDFDesk.Controls.NoticeHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="NoticeHost_SizeChanged"
    IsHitTestVisible="True">

    <Border
        x:Name="Card"
        Visibility="Collapsed"
        MaxWidth="{StaticResource NoticeMaxWidth}"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Margin="8,8,8,0"
        CornerRadius="12"
        Translation="0,0,32"
        PointerEntered="Card_PointerEntered"
        PointerExited="Card_PointerExited"
        Background="{ThemeResource HomeCardBrush}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="CardOffset" />
        </Border.RenderTransform>
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>

        <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="12" Padding="16,14,12,14">
            <Grid VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                <FontIcon x:Name="InformationIcon" Glyph="&#xE946;" FontSize="20"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" Visibility="Collapsed" />
                <FontIcon x:Name="SuccessIcon" Glyph="&#xE73E;" FontSize="20"
                          Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed" />
                <FontIcon x:Name="WarningIcon" Glyph="&#xE7BA;" FontSize="20"
                          Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                <FontIcon x:Name="ErrorIcon" Glyph="&#xEA39;" FontSize="20"
                          Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
            </Grid>

            <TextBlock x:Name="NoticeText" Grid.Column="1" VerticalAlignment="Center"
                       TextWrapping="Wrap" Foreground="{ThemeResource HomeTextBrush}">
                <Run x:Name="NoticeTitle" FontWeight="SemiBold" /><Run x:Name="NoticeMessage" />
            </TextBlock>

            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="32" Height="32"
                    CornerRadius="8" VerticalAlignment="Top" Click="CloseButton_Click"
                    AutomationProperties.Name="{Binding Close, Source={StaticResource UiText}}"
                    ToolTipService.ToolTip="{Binding Close, Source={StaticResource UiText}}">
                <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource HomeSecondaryTextBrush}" />
            </Button>
        </Grid>
    </Border>
</UserControl>
