<ContentDialog
    x:Class="PDFDesk.Controls.RecycleFilesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:styles="using:PDFDesk.Styles"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PDFDesk.Controls"
    Style="{StaticResource DefaultContentDialogStyle}" CornerRadius="{StaticResource ReaderToolbarRadius}"
    Opened="Dialog_Opened">
    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
    </ContentDialog.Resources>
    <StackPanel Padding="24" MaxWidth="468" Spacing="{StaticResource SpaceL}">
        <StackPanel Spacing="{StaticResource SpaceXS}">
            <TextBlock x:Name="Heading" Style="{StaticResource SubtitleTextBlockStyle}"
                       AutomationProperties.HeadingLevel="Level2" TextWrapping="Wrap" />
            <TextBlock Text="{Binding RecycleRecentHint, Source={StaticResource UiText}}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Border Style="{StaticResource ReaderSideGroupStyle}" Padding="12,4">
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="FileList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="controls:RecentCard">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceM}" Padding="0,8"
                                  ToolTipService.ToolTip="{x:Bind Path}">
                                <FontIcon Glyph="&#xEA90;" FontSize="20" Foreground="{ThemeResource HomeSecondaryTextBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextWrapping="WrapWholeWords"
                                               IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{x:Bind DirectoryName}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource HomeSecondaryTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <TextBlock Text="{Binding RecyclePermanentHint, Source={StaticResource UiText}}" TextWrapping="Wrap"
                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource HomeSecondaryTextBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource SpaceS}">
            <Button x:Name="Dismiss" Content="{Binding Cancel, Source={StaticResource UiText}}" Click="Dismiss_Click" Padding="16,6" />
            <Button x:Name="Confirm" styles:DestructiveAction.IsEnabled="True" Click="Confirm_Click" Padding="16,6">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                    <FontIcon Glyph="&#xE74D;" FontSize="{StaticResource IconGlyphSize}" />
                    <TextBlock Text="{Binding MoveToRecycleBin, Source={StaticResource UiText}}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</ContentDialog>
