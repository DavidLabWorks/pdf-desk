<!-- Design tokens: the ONLY place new spacing/radius/size constants may be
     defined. GNOME-HIG-inspired scale (4/8/12/16/24) on Fluent controls. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Spacing scale -->
    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">12</x:Double>
    <x:Double x:Key="SpaceL">16</x:Double>
    <x:Double x:Key="SpaceXL">24</x:Double>
    <Thickness x:Key="ReaderPaneMargin">0,0,4,0</Thickness>

    <!-- Header bar (Papers headerbar is 47px @1x; 44 reads right on Fluent) -->
    <x:Double x:Key="HeaderHeight">44</x:Double>
    <Thickness x:Key="ReaderToolbarMargin">8,8</Thickness>
    <x:Double x:Key="ReaderToolbarGroupGap">10</x:Double>
    <CornerRadius x:Key="ReaderToolbarRadius">12</CornerRadius>
    <x:Double x:Key="IconButtonSize">34</x:Double>
    <x:Double x:Key="IconGlyphSize">16</x:Double>

    <!-- Fluent's minimum comfortable touch target. The 34px header buttons are
         deliberately left below it: they sit in a 44px bar with 2px gaps, so a
         finger that misses one hits its neighbour rather than nothing, and
         widening them would loosen the proportions the header is built on. It
         is the controls that float alone — the zoom pill, the find bar, the
         sidebar switcher — where a miss hits the page instead, and those are
         sized from here. -->
    <x:Double x:Key="TouchTargetMin">40</x:Double>

    <!-- Corner radii -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusPill">18</CornerRadius>

    <x:Double x:Key="NoticeMaxWidth">400</x:Double>

    <!-- Homepage -->
    <x:Double x:Key="ShelfCardWidth">164</x:Double>
    <x:Double x:Key="CardHeight">184</x:Double>
    <x:Double x:Key="HomePlaceholderCoverWidth">104</x:Double>
    <x:Double x:Key="HomePlaceholderCoverHeight">144</x:Double>
    <x:Double x:Key="HomeOpenerHeadingSize">19</x:Double>
    <x:Double x:Key="HomePaperStackWidth">104</x:Double>
    <x:Double x:Key="HomePaperStackHeight">112</x:Double>
    <x:Double x:Key="HomeCompactPaperHeight">64</x:Double>
    <x:Double x:Key="HomePaperWidth">72</x:Double>
    <x:Double x:Key="HomePaperHeight">94</x:Double>
    <x:Double x:Key="HomePaperLabelSize">10</x:Double>
    <x:Double x:Key="HomePreviewIconSize">32</x:Double>

    <!-- Pen options panel -->
    <x:Double x:Key="InkSwatchSize">32</x:Double>
    <x:Double x:Key="HeaderSeparatorHeight">20</x:Double>

    <x:Double x:Key="OrganizerDragWidth">148</x:Double>
    <x:Double x:Key="OrganizerDragHeight">142</x:Double>
    <Thickness x:Key="OrganizerPadding">8</Thickness>
    <!-- Sidebar. Thumbnail boxes take their height from each page's own aspect
         ratio; the clamps keep a poster (1:10) or a banner (10:1) usable. -->
    <x:Double x:Key="SidebarWidth">280</x:Double>
    <x:Double x:Key="SidebarThumbWidth">168</x:Double>
    <x:Double x:Key="SidebarThumbMinHeight">96</x:Double>
    <x:Double x:Key="SidebarThumbMaxHeight">320</x:Double>
</ResourceDictionary>
