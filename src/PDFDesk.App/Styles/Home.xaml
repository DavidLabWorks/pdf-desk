<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ShelfFolderIconBrush" Color="#D99A00" />
            <x:Double x:Key="FolderSelectedOpacity">0.12</x:Double>
            <x:Double x:Key="FolderHoverOpacity">0.17</x:Double>
            <x:Double x:Key="FolderPressedOpacity">0.22</x:Double>
            <SolidColorBrush x:Key="ShelfFavoriteBrush" Color="#D99A00" />
            <SolidColorBrush x:Key="CaptionHoverBrush" Color="#DFDFDF" />
            <SolidColorBrush x:Key="CaptionMinimizeHoverBrush" Color="#E7E7E7" />
            <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#E81123" />
            <SolidColorBrush x:Key="CaptionPressedBrush" Color="#CDCDCD" />
            <SolidColorBrush x:Key="CaptionHoverForegroundBrush" Color="{ThemeResource SystemBaseHighColor}" />
            <Color x:Key="CaptionCloseGlyphColor">#FFFFFF</Color>
            <Color x:Key="CaptionClosePressedColor">#C50F1F</Color>
            <SolidColorBrush x:Key="HomeCanvasBrush" Color="#EAEAEA" />
            <SolidColorBrush x:Key="HomeNavigationBrush" Color="#FAFAFA" />
            <SolidColorBrush x:Key="ReaderWorkspaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="HomeShelfBrush" Color="#DDDDDD" />
            <SolidColorBrush x:Key="HomeSectionBrush" Color="#DBDBDB" />
            <SolidColorBrush x:Key="HomePaperBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="HomeTextBrush" Color="#202020" />
            <SolidColorBrush x:Key="HomeSecondaryTextBrush" Color="#626262" />
            <SolidColorBrush x:Key="HomeOutlineBrush" Color="#E3E3E3" />
            <SolidColorBrush x:Key="HomePaperStrokeBrush" Color="#CBCBCB" />
            <SolidColorBrush x:Key="HomeLayerBrush" Color="#F0F0F0" />
            <SolidColorBrush x:Key="HomeShortcutDividerBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="HomeCardBrush" Color="#F5F5F5" />
            <StaticResource x:Key="ReaderToggleTextColor" ResourceKey="SystemBaseHighColor" />
            <Color x:Key="ReaderToggleCheckedColor">#DBDBDB</Color>
            <Color x:Key="ReaderToggleCheckedHoverColor">#CBCBCB</Color>
            <Color x:Key="HomeCardHoverColor">#FFFFFF</Color>
            <Color x:Key="HomeCardHoverTextColor">#202020</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ShelfFolderIconBrush" Color="#EAC474" />
            <x:Double x:Key="FolderSelectedOpacity">0.18</x:Double>
            <x:Double x:Key="FolderHoverOpacity">0.23</x:Double>
            <x:Double x:Key="FolderPressedOpacity">0.28</x:Double>
            <SolidColorBrush x:Key="ShelfFavoriteBrush" Color="#FFD255" />
            <SolidColorBrush x:Key="CaptionHoverBrush" Color="#393A3D" />
            <SolidColorBrush x:Key="CaptionMinimizeHoverBrush" Color="#333436" />
            <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#E81123" />
            <SolidColorBrush x:Key="CaptionPressedBrush" Color="#494A4E" />
            <SolidColorBrush x:Key="CaptionHoverForegroundBrush" Color="{ThemeResource SystemBaseHighColor}" />
            <Color x:Key="CaptionCloseGlyphColor">#FFFFFF</Color>
            <Color x:Key="CaptionClosePressedColor">#C50F1F</Color>
            <SolidColorBrush x:Key="HomeCanvasBrush" Color="#222324" />
            <SolidColorBrush x:Key="HomeNavigationBrush" Color="#191A1B" />
            <SolidColorBrush x:Key="ReaderWorkspaceBrush" Color="#191A1B" />
            <SolidColorBrush x:Key="HomeShelfBrush" Color="#292B2D" />
            <SolidColorBrush x:Key="HomeSectionBrush" Color="#323438" />
            <SolidColorBrush x:Key="HomePaperBrush" Color="#343434" />
            <SolidColorBrush x:Key="HomeTextBrush" Color="#F2F2F2" />
            <SolidColorBrush x:Key="HomeSecondaryTextBrush" Color="#B7B7B7" />
            <SolidColorBrush x:Key="HomeOutlineBrush" Color="#353535" />
            <SolidColorBrush x:Key="HomePaperStrokeBrush" Color="#535353" />
            <SolidColorBrush x:Key="HomeLayerBrush" Color="#2C2C2C" />
            <SolidColorBrush x:Key="HomeShortcutDividerBrush" Color="#66000000" />
            <SolidColorBrush x:Key="HomeCardBrush" Color="#323438" />
            <StaticResource x:Key="ReaderToggleTextColor" ResourceKey="SystemBaseHighColor" />
            <Color x:Key="ReaderToggleCheckedColor">#4C4E52</Color>
            <Color x:Key="ReaderToggleCheckedHoverColor">#585A5E</Color>
            <Color x:Key="HomeCardHoverColor">#404247</Color>
            <Color x:Key="HomeCardHoverTextColor">#F2F2F2</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ShelfFolderIconBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <x:Double x:Key="FolderSelectedOpacity">0.12</x:Double>
            <x:Double x:Key="FolderHoverOpacity">0.17</x:Double>
            <x:Double x:Key="FolderPressedOpacity">0.22</x:Double>
            <SolidColorBrush x:Key="ShelfFavoriteBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CaptionHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CaptionMinimizeHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CaptionPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CaptionHoverForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <StaticResource x:Key="CaptionCloseGlyphColor" ResourceKey="SystemColorHighlightTextColor" />
            <StaticResource x:Key="CaptionClosePressedColor" ResourceKey="SystemColorHighlightColor" />
            <SolidColorBrush x:Key="HomeCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HomeNavigationBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ReaderWorkspaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HomeShelfBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HomeSectionBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HomePaperBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HomeTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HomeSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HomeOutlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HomePaperStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HomeLayerBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HomeShortcutDividerBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="HomeCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <StaticResource x:Key="HomeCardHoverTextColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="ReaderToggleTextColor" ResourceKey="SystemColorHighlightTextColor" />
            <StaticResource x:Key="ReaderToggleCheckedColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="ReaderToggleCheckedHoverColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="HomeCardHoverColor" ResourceKey="SystemColorWindowColor" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="ShelfFavoriteToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Feedback.Opacity" Value="0.08" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Feedback.Opacity" Value="0.14" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Star.Glyph" Value="&#xE735;" />
                                        <Setter Target="Star.Foreground" Value="{ThemeResource ShelfFavoriteBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Star.Glyph" Value="&#xE735;" />
                                        <Setter Target="Star.Foreground" Value="{ThemeResource ShelfFavoriteBrush}" />
                                        <Setter Target="Feedback.Opacity" Value="0.08" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Star.Glyph" Value="&#xE735;" />
                                        <Setter Target="Star.Foreground" Value="{ThemeResource ShelfFavoriteBrush}" />
                                        <Setter Target="Feedback.Opacity" Value="0.14" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid Width="24" Height="24">
                            <Border CornerRadius="12" Background="{ThemeResource HomeCardBrush}" />
                            <Border x:Name="Feedback" CornerRadius="12" Background="{ThemeResource HomeTextBrush}" Opacity="0" />
                            <FontIcon x:Name="Star" Glyph="&#xE734;" FontSize="15" Foreground="{ThemeResource HomeSecondaryTextBrush}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShelfSectionStyle" TargetType="RadioButton">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="48" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource HomeTextBrush}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters><Setter Target="Fill.Opacity" Value="1" /></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Fill" CornerRadius="11" Background="{ThemeResource HomeSectionBrush}" Opacity="0" />
                        <ContentPresenter Padding="18,0" Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HomeHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource HomeTextBrush}" />
    </Style>

    <Style x:Key="HomeCoverStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource HomePaperBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HomeOutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    </Style>

    <DataTemplate x:Key="HomeBrowseButtonContent">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
            <FontIcon Glyph="&#xE710;" FontSize="14" VerticalAlignment="Center"
                      AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border
                Padding="8,0,0,0"
                BorderThickness="1,0,0,0"
                BorderBrush="{ThemeResource HomeShortcutDividerBrush}"
                AutomationProperties.AccessibilityView="Raw">
                <TextBlock Text="Ctrl + O" Style="{StaticResource CaptionTextBlockStyle}" />
            </Border>
        </StackPanel>
    </DataTemplate>

    <Style x:Key="HomeBrowseButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinWidth" Value="186" />
        <Setter Property="ContentTemplate" Value="{StaticResource HomeBrowseButtonContent}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="AutomationProperties.AcceleratorKey" Value="Ctrl+O" />
        <Setter Property="ToolTipService.ToolTip" Value="Browse files (Ctrl+O)" />
    </Style>
</ResourceDictionary>
