<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ReaderToolbarHoverBrush" Color="#E3E3E3" />
            <SolidColorBrush x:Key="ReaderToolbarPressedBrush" Color="#D8D8D8" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ReaderToolbarHoverBrush" Color="#45474B" />
            <SolidColorBrush x:Key="ReaderToolbarPressedBrush" Color="#505256" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="ReaderToolbarHoverBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="ReaderToolbarPressedBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ReaderToolbarHoverBrush" />
    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ReaderToolbarPressedBrush" />
    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="ReaderToolbarHoverBrush" />
    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="ReaderToolbarPressedBrush" />
</ResourceDictionary>
